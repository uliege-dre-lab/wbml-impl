    ]
  ] .

#################################################################
# ITEMS
#################################################################

<#ItemMapping>
  a wbml:StatementsMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        type,
        description,
        name.english AS name_en,
        name.japanese AS name_ja,
        name.chinese AS name_zh
      FROM read_json('demonstrators/pokemon/input_data/items_small.json')
    """
  ] ;

  wbml:entityMap [
    wbml:entityTemplate "Item_{id}" ;
    wbml:class ex:ItemClass
  ] ;

  wbml:labelMap [ wbml:reference "name_en" ; wbml:language "en" ] ;

  wbml:labelMap [ wbml:reference "name_ja" ; wbml:language "ja" ] ;

  wbml:labelMap [ wbml:reference "name_zh" ; wbml:language "zh" ] ;

  wbml:descriptionMap [ wbml:reference "description" ; wbml:language "en" ] ;

  wbml:statementMap [
    wbml:property ex:ItemNumber ;
    wbml:valueMap [ wbml:reference "id" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:statementMap [
    wbml:property ex:HasItemCategory ;
    wbml:valueMap [
        wbml:parentStatementsMap <#ItemCategoryMapping> ;
        wbml:joinCondition [
        wbml:child "type" ;
        wbml:parent "type"
        ]
    ]
    ] .

<#ItemCategoryMapping>
  a wbml:StatementsMap ;

  rml:logicalSource [
    rml:query """
      SELECT DISTINCT type
      FROM read_json('demonstrators/pokemon/input_data/items_small.json')
      WHERE type IS NOT NULL
    """
  ] ;

  wbml:entityMap [
    wbml:entityTemplate "ItemCategory_{type}" ;
    wbml:class [
      a wbml:Class ;
      wbml:entityTemplate "ItemCategory" ;
      wbml:label "Item Category"@en ;
      wbml:label "Catégorie d'objet"@fr ;
      wbml:description "A category or classification for items in the Pokémon games."@en ;
      wbml:alias "Pokemon Item Category"@en
    ]
  ] ;

  wbml:labelMap [ wbml:reference "type" ; wbml:language "en" ] .
