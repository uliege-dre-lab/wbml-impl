  wbml:entityMap [
    wbml:entityTemplate "Type_{english}" ;
    wbml:class ex:TypeClass
  ] ;

  wbml:statementMap [
    wbml:property ex:EffectiveAgainst ;
    wbml:valueMap [
      wbml:entityTemplate "Type_{target_type}"
    ]
  ] .

<#TypeIneffectiveMapping>
  a wbml:StatementsMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        english,
        unnest(ineffective) AS target_type
      FROM read_json('demonstrators/pokemon/input_data/types.json')
      WHERE ineffective IS NOT NULL
    """
  ] ;

  wbml:entityMap [
    wbml:entityTemplate "Type_{english}" ;
    wbml:class ex:TypeClass
  ] ;

  wbml:statementMap [
    wbml:property ex:IneffectiveAgainst ;
    wbml:valueMap [
      wbml:entityTemplate "Type_{target_type}"
    ]
  ] .

<#TypeNoEffectMapping>
  a wbml:StatementsMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        english,
        unnest(no_effect) AS target_type
      FROM read_json('demonstrators/pokemon/input_data/types.json')
      WHERE no_effect IS NOT NULL
    """
  ] ;

  wbml:entityMap [
    wbml:entityTemplate "Type_{english}" ;
    wbml:class ex:TypeClass
  ] ;

  wbml:statementMap [
