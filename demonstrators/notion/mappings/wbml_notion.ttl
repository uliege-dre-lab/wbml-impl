@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wbml: <http://w3id.org/dre/wbml#> .

<#ClassMapping>
  a wbml:StatementsMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        "Nom de la classe" AS name,
        "Autres labels" AS alias,
        "Description" AS description,
        "English name" AS name_en,
        "Alternative labels (EN)" AS alias_en,
        "Description (EN)" AS description_en
      FROM read_csv(
        'demonstrators/notion/input_data/classes_with_english_translations.csv',
        header = true
      )
      WHERE "Nom de la classe" IS NOT NULL
        AND trim("Nom de la classe") != ''
    """
  ] ;

  wbml:entityMap [
    wbml:entityTemplate "Class_{name}" ;
  ] ;

  wbml:labelMap [
    wbml:reference "name" ;
    wbml:language "fr"
  ] ;

  wbml:labelMap [
    wbml:reference "name_en" ;
    wbml:language "en"
  ] ;

  wbml:aliasMap [
    wbml:reference "alias" ;
    wbml:language "fr"
  ] ;

  wbml:aliasMap [
    wbml:reference "alias_en" ;
    wbml:language "en"
  ] ;

  wbml:descriptionMap [
    wbml:reference "description" ;
    wbml:language "fr"
  ] ;

  wbml:descriptionMap [
    wbml:reference "description_en" ;
    wbml:language "en"
  ] .

<#ClassesHierarchyMapping>
  a wbml:StatementsMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        "Nom de la classe" AS name,
        "Hiérarchie (classe parent)" AS parent_class
      FROM read_csv(
        'demonstrators/notion/input_data/classes_with_english_translations.csv',
        header = true
      )
      WHERE "Nom de la classe" IS NOT NULL
        AND trim("Nom de la classe") != ''
        AND "Hiérarchie (classe parent)" IS NOT NULL
        AND trim("Hiérarchie (classe parent)") != ''
    """
  ] ;

  wbml:entityMap [
    wbml:entityTemplate "Class_{name}" ;
  ] ;

  wbml:statementMap [
    wbml:property rdfs:subClassOf ;
    wbml:valueMap [
      wbml:entityTemplate "Class_{parent_class}"
    ]
  ] .

<#StringDataPropertyMapping>
  a wbml:StatementsMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        "Nom" AS name,
        "Description" AS description,
        "Domaine" AS domain,
        "English name" AS name_en,
        "Description (EN)" AS description_en,
        "Cardinalité" AS cardinality,
        "Bonnes pratiques" AS good_practices
      FROM read_csv(
        'demonstrators/notion/input_data/data_properties_with_english_translations.csv',
        header = true
      )
      WHERE "Nom" IS NOT NULL
        AND trim("Nom") != ''
        AND (
          "Portée" IS NULL
          OR "Portée" NOT IN ('URL', 'URI', 'DateTime')
        )
    """
  ] ;

  wbml:entityMap [
    wbml:entityTemplate "Property_{name}" ;
    wbml:entityType wbml:Property ;
    wbml:propertyType wbml:string
  ] ;

  wbml:labelMap [
    wbml:reference "name" ;
    wbml:language "fr"
  ] ;

  wbml:labelMap [
    wbml:reference "name_en" ;
    wbml:language "en"
  ] ;

  wbml:descriptionMap [
    wbml:reference "description" ;
    wbml:language "fr"
  ] ;

  wbml:descriptionMap [
    wbml:reference "description_en" ;
    wbml:language "en"
  ] ;

  wbml:statementMap [
    wbml:propertyMap [
      a wbml:Property ;
      wbml:entityTemplate "goodPractice" ;
      wbml:label "Good practice"@en ;
      wbml:label "Bonnes pratiques"@fr ;
      wbml:propertyType wbml:string
    ] ;
    wbml:valueMap [
      wbml:reference "good_practices"
    ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap [
      a wbml:Property ;
      wbml:entityTemplate "cardinality" ;
      wbml:label "Cardinality"@en ;
      wbml:label "Cardinalité"@fr ;
      wbml:propertyType wbml:string
    ] ;
    wbml:valueMap [
      wbml:reference "cardinality"
    ]
  ] .

<#URLDataPropertyMapping>
  a wbml:StatementsMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        "Nom" AS name,
        "Description" AS description,
        "Domaine" AS domain,
        "English name" AS name_en,
        "Description (EN)" AS description_en,
        "Cardinalité" AS cardinality,
        "Bonnes pratiques" AS good_practices
      FROM read_csv(
        'demonstrators/notion/input_data/data_properties_with_english_translations.csv',
        header = true
      )
      WHERE "Nom" IS NOT NULL
        AND trim("Nom") != ''
        AND "Portée" IN ('URL', 'URI')
    """
  ] ;

  wbml:entityMap [
    wbml:entityTemplate "Property_{name}" ;
    wbml:entityType wbml:Property ;
    wbml:propertyType wbml:url
  ] ;

  wbml:labelMap [
    wbml:reference "name" ;
    wbml:language "fr"
  ] ;

  wbml:labelMap [
    wbml:reference "name_en" ;
    wbml:language "en"
  ] ;

  wbml:descriptionMap [
    wbml:reference "description" ;
    wbml:language "fr"
  ] ;

  wbml:descriptionMap [
    wbml:reference "description_en" ;
    wbml:language "en"
  ] .

<#TimeDataPropertyMapping>
  a wbml:StatementsMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        "Nom" AS name,
        "Description" AS description,
        "Domaine" AS domain,
        "English name" AS name_en,
        "Description (EN)" AS description_en,
        "Cardinalité" AS cardinality,
        "Bonnes pratiques" AS good_practices
      FROM read_csv(
        'demonstrators/notion/input_data/data_properties_with_english_translations.csv',
        header = true
      )
      WHERE "Nom" IS NOT NULL
        AND trim("Nom") != ''
        AND "Portée" = 'DateTime'
    """
  ] ;

  wbml:entityMap [
    wbml:entityTemplate "Property_{name}" ;
    wbml:entityType wbml:Property ;
    wbml:propertyType wbml:time
  ] ;

  wbml:labelMap [
    wbml:reference "name" ;
    wbml:language "fr"
  ] ;

  wbml:labelMap [
    wbml:reference "name_en" ;
    wbml:language "en"
  ] ;

  wbml:descriptionMap [
    wbml:reference "description" ;
    wbml:language "fr"
  ] ;

  wbml:descriptionMap [
    wbml:reference "description_en" ;
    wbml:language "en"
  ] .

<#ObjectPropertyMapping>
  a wbml:StatementsMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        "Nom" AS name,
        "Description" AS description,
        "Domaine" AS domain,
        "English name" AS name_en,
        "Description (EN)" AS description_en,
        "Cardinalité" AS cardinality,
        "Bonnes pratiques" AS good_practices,
        "Inverse" AS inverse,
        regexp_replace("Portée", ' \\(.*\\)$', '') AS range_class
      FROM read_csv(
        'demonstrators/notion/input_data/object_properties_with_english_translations.csv',
        header = true
      )
      WHERE "Nom" IS NOT NULL
        AND trim("Nom") != ''
    """
  ] ;

  wbml:entityMap [
    wbml:entityTemplate "Property_{name}" ;
    wbml:entityType wbml:Property ;
    wbml:propertyType wbml:item ;
  ] ;

  wbml:labelMap [
    wbml:reference "name" ;
    wbml:language "fr"
  ] ;

  wbml:labelMap [
    wbml:reference "name_en" ;
    wbml:language "en"
  ] ;

  wbml:descriptionMap [
    wbml:reference "description" ;
    wbml:language "fr"
  ] ;

  wbml:descriptionMap [
    wbml:reference "description_en" ;
    wbml:language "en"
  ] ;

  wbml:statementMap [
    wbml:propertyMap [
      a wbml:Property ;
      wbml:entityTemplate "goodPractice" ;
      wbml:label "Good practice"@en ;
      wbml:label "Bonnes pratiques"@fr ;
      wbml:propertyType wbml:string
    ] ;
    wbml:valueMap [
      wbml:reference "good_practices"
    ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap [
      a wbml:Property ;
      wbml:entityTemplate "cardinality" ;
      wbml:label "Cardinality"@en ;
      wbml:label "Cardinalité"@fr ;
      wbml:propertyType wbml:string
    ] ;
    wbml:valueMap [
      wbml:reference "cardinality"
    ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap [
      a wbml:Property ;
      wbml:entityTemplate "inverse" ;
      wbml:label "Inverse property"@en ;
      wbml:label "Propriété inverse"@fr ;
      wbml:propertyType wbml:string
    ] ;
    wbml:valueMap [
      wbml:reference "inverse"
    ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap [
      a wbml:Property ;
      wbml:entityTemplate "rangeClass" ;
      wbml:label "Range class"@en ;
      wbml:label "Classe de portée"@fr ;
      wbml:propertyType wbml:item
    ] ;
    wbml:valueMap [
      wbml:entityTemplate "Class_{range_class}"
    ]
  ] .
