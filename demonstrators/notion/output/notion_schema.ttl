@prefix ns1: <https://example.org/wbml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:wikibase:property:cardinality> a rdf:Property ;
    rdfs:label "Cardinality"@en,
        "Cardinalité"@fr ;
    ns1:propertyType ns1:string .

<urn:wikibase:property:goodPractice> a rdf:Property ;
    rdfs:label "Good practice"@en,
        "Bonnes pratiques"@fr ;
    ns1:propertyType ns1:string .

<urn:wikibase:property:inverse> a rdf:Property ;
    rdfs:label "Inverse property"@en,
        "Propriété inverse"@fr ;
    ns1:propertyType ns1:string .

<urn:wikibase:property:rangeClass> a rdf:Property ;
    rdfs:label "Range class"@en,
        "Classe de portée"@fr ;
    ns1:propertyType ns1:item .
