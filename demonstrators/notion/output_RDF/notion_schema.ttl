@prefix ns1: <https://example.org/wbml#> .

<urn:wikibase:property:> a ns1:Property ;
    ns1:propertyType ns1:item,
        ns1:string,
        ns1:time,
        ns1:url .

<urn:wikibase:property:cardinality> a ns1:Property ;
    ns1:entityLabel "Cardinality"@en,
        "Cardinalité"@fr ;
    ns1:propertyType ns1:string .

<urn:wikibase:property:goodPractice> a ns1:Property ;
    ns1:entityLabel "Good practice"@en,
        "Bonnes pratiques"@fr ;
    ns1:propertyType ns1:string .

<urn:wikibase:property:inverse> a ns1:Property ;
    ns1:entityLabel "Inverse property"@en,
        "Propriété inverse"@fr ;
    ns1:propertyType ns1:string .

<urn:wikibase:property:rangeClass> a ns1:Property ;
    ns1:entityLabel "Range class"@en,
        "Classe de portée"@fr ;
    ns1:propertyType ns1:item .
