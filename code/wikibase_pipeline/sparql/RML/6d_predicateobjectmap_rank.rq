PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

PREFIX wbml: <http://w3id.org/dre/wbml#>
PREFIX wbint: <http://w3id.org/dre/wbint#>

CONSTRUCT {
  ?stmtTM a rr:TriplesMap ;
          rml:logicalSource ?ls ;
          rr:subjectMap ?stmtSM ;
          rr:predicateObjectMap ?rankPOM .

  ?stmtSM rr:template ?stmtTemplate ;
          rr:termType rr:IRI .

  ?rankPOM rr:predicate wbml:rank ;
           rr:objectMap ?rankOM .

  ?rankOM rr:constant ?rankIRI .
}
WHERE {
  ?tm a wbml:StatementsMap ;
      rml:logicalSource ?ls ;
      wbml:statementMap ?pom ;
      wbml:entityMap ?sm .

  OPTIONAL { ?sm wbml:entityTemplate ?subjectEntityTemplate . }
  OPTIONAL { ?sm wbml:entityId ?subjectEntityId . }
  FILTER(BOUND(?subjectEntityTemplate) || BOUND(?subjectEntityId))
  BIND(COALESCE(?subjectEntityTemplate, ?subjectEntityId) AS ?subjectKey)

  ?pom wbint:statID ?statID ;
       wbml:valueMap ?wom ;
       wbml:rank ?rankIRI .

  OPTIONAL { ?pom wbml:propertyMap ?propertyBlank . }
  OPTIONAL { ?pom wbml:propertyId ?propertyIdStr . }
  OPTIONAL { ?pom wbml:property ?propertyConst . }
  FILTER(BOUND(?propertyBlank) || BOUND(?propertyIdStr) || BOUND(?propertyConst))


  OPTIONAL { ?wom wbml:reference ?mainReference . }
  OPTIONAL { ?wom wbml:entityTemplate ?mainValueEntityTemplate . }
  OPTIONAL { ?wom wbml:joinCondition / wbml:child ?childKey . }
  OPTIONAL { ?wom wbml:template ?mainValueTemplate . }

  BIND(IRI(CONCAT(STR(?tm), "/statement/", STR(?statID))) AS ?stmtTM)

  BIND(
    IF(BOUND(?mainReference),       CONCAT("_{", STR(?mainReference), "}"),
    IF(BOUND(?mainValueEntityTemplate), CONCAT("_", STR(?mainValueEntityTemplate)),
    IF(BOUND(?childKey),            CONCAT("_{", STR(?childKey), "}"),
    IF(BOUND(?mainValueTemplate), CONCAT("_", STR(?mainValueTemplate)),
     ""))))
  AS ?valueSuffix)

  BIND(
    CONCAT(
      "urn:wikibase:statement:", STR(?subjectKey), "_", STR(?statID), ?valueSuffix
    )
    AS ?stmtTemplate
  )

  BIND(IRI(CONCAT(STR(?stmtTM), "/pom/rank")) AS ?rankPOM)
  BIND(IRI(CONCAT(STR(?rankPOM), "/om")) AS ?rankOM)
}
