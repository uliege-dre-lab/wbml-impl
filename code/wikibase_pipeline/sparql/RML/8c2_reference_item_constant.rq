PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX wbml: <http://w3id.org/dre/wbml#>
PREFIX wbint: <http://w3id.org/dre/wbint#>

CONSTRUCT {
  ?refTM a rr:TriplesMap ;
         rml:logicalSource ?ls ;
         rr:subjectMap ?refSM ;
         rr:predicateObjectMap ?recordPOM .

  ?refSM rr:template ?stmtRefTemplate ;
         rr:termType rr:IRI .

  ?recordPOM rr:predicate ?refPropIRI ;
             rr:objectMap ?recordOM .

  ?recordOM rr:constant ?valueConstant .
}
WHERE {
  {
    SELECT ?tm ?ls ?subjectEntityTemplate ?subjectEntityId ?statID ?wom
           ?mainReference ?mainValueNode ?childKey
           ?rmap ?refId ?rrec ?refPropertyBlank ?refPropertyId ?refPropertyConst
           ?rom ?valueEntityTemplate ?valueEntityId ?refExplicitKey ?refConstExplicitKey ?refConstType
    WHERE {
      ?tm a wbml:StatementsMap ;
          rml:logicalSource ?ls ;
          wbml:statementMap ?pom ;
          wbml:entityMap ?sm .

      OPTIONAL { ?sm wbml:entityTemplate ?subjectEntityTemplate . }
      OPTIONAL { ?sm wbml:entityId ?subjectEntityId . }
      FILTER(BOUND(?subjectEntityTemplate) || BOUND(?subjectEntityId))

      ?pom wbint:statID ?statID ;
           wbml:valueMap ?wom ;
           wbml:referenceMap ?rmap .

      OPTIONAL { ?wom wbml:reference ?mainReference . }
      OPTIONAL { ?wom wbml:entityTemplate ?mainValueEntityTemplate . }
      OPTIONAL { ?wom wbml:entityId ?mainValueEntityId . }
      OPTIONAL { ?wom wbml:joinCondition / wbml:child ?childKey . }
      OPTIONAL { ?wom wbml:template ?mainValueTemplate . }

      BIND(COALESCE(?mainValueEntityTemplate, ?mainValueEntityId) AS ?mainValueNode)

      ?rmap wbint:refId ?refId ;
            wbml:referenceRecord ?rrec .

      ?rrec wbml:valueMap ?rom .

      OPTIONAL {
        ?rrec wbml:propertyMap ?refPropertyBlank .
        OPTIONAL { ?refPropertyBlank wbml:entityTemplate ?refExplicitKey . }
      }
      OPTIONAL { ?rrec wbml:propertyId ?refPropertyId . }
      OPTIONAL {
        ?rrec wbml:property ?refPropertyConst .
        OPTIONAL { ?refPropertyConst wbml:entityTemplate ?refConstExplicitKey . }
        OPTIONAL { ?refPropertyConst wbml:propertyType   ?refConstType . }
      }
      FILTER(BOUND(?refPropertyBlank) || BOUND(?refPropertyId) || BOUND(?refPropertyConst))

      OPTIONAL { ?rom wbml:entityTemplate ?valueEntityTemplate . }
      OPTIONAL { ?rom wbml:entityId ?valueEntityId . }
      FILTER(
        (BOUND(?valueEntityTemplate) && !CONTAINS(STR(?valueEntityTemplate), "{")) ||
        (BOUND(?valueEntityId)       && !CONTAINS(STR(?valueEntityId), "{"))
      )
    }
  }

  BIND(IRI(CONCAT(STR(?tm), "/statement/", STR(?statID), "/reference/", STR(?refId))) AS ?refTM)
  BIND(IRI(CONCAT(STR(?refTM), "/subjectMap")) AS ?refSM)
  BIND(IRI(CONCAT(STR(?refTM), "/pom/referenceRecord/", ENCODE_FOR_URI(STR(?rrec)))) AS ?recordPOM)
  BIND(IRI(CONCAT(STR(?recordPOM), "/om")) AS ?recordOM)

  BIND(
    IF(BOUND(?refPropertyId),
      IRI(CONCAT("urn:wikibase:referenceIRI:", ?refPropertyId)),
      IF(BOUND(?refPropertyBlank),
        IRI(CONCAT("urn:wikibase:reference:", STR(?refExplicitKey))),
        IF(BOUND(?refConstExplicitKey),
          IRI(CONCAT("urn:wikibase:reference:", STR(?refConstExplicitKey))),
          IF(BOUND(?refConstType),
            IRI(CONCAT("urn:wikibase:reference:", STRAFTER(STR(?refPropertyConst), "#"))),
            ?refPropertyConst
          )
        )
      )
    ) AS ?refPropIRI
  )

  BIND(
    IF(BOUND(?mainReference),         CONCAT("_{", STR(?mainReference), "}"),
    IF(BOUND(?mainValueNode),  CONCAT("_", STR(?mainValueNode)),
    IF(BOUND(?childKey),               CONCAT("_{", STR(?childKey), "}"),
    IF(BOUND(?mainValueTemplate), CONCAT("_", STR(?mainValueTemplate)),
     ""))))
  AS ?valueSuffix)

  BIND(COALESCE(?subjectEntityTemplate, ?subjectEntityId) AS ?subjectKey)

  BIND(
    CONCAT(
      "urn:wikibase:statementreference:", STR(?subjectKey), "_", STR(?statID),
      ?valueSuffix, "_", STR(?refId)
    )
    AS ?stmtRefTemplate
  )

  BIND(
    IF(BOUND(?valueEntityId),
      IRI(CONCAT("urn:wikibase:itemIRI:", STR(?valueEntityId))),
      IRI(CONCAT("urn:wikibase:item:",    STR(?valueEntityTemplate)))
    ) AS ?valueConstant
  )
}
