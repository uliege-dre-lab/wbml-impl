PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>

PREFIX wbml: <https://example.org/wbml#>
PREFIX wbint: <https://example.org/wbint#>

CONSTRUCT {
  ?stmtTM a rr:TriplesMap ;
          rml:logicalSource ?ls ;
          rr:subjectMap ?stmtSM ;
          rr:predicateObjectMap ?qualifierPOM .

  ?stmtSM rr:template ?stmtTemplate ;
          rr:termType rr:IRI .

  ?qualifierPOM rr:predicate ?qualifierPredIRI ;
                rr:objectMap ?qualifierOM .

  ?qualifierOM rr:parentTriplesMap ?parentTM .
  ?qualifierOM rr:joinCondition ?joinNode .
  ?joinNode rr:child ?childField ;
            rr:parent ?parentField .
}
WHERE {
  ?tm a rr:TriplesMap ;
      rml:logicalSource ?ls ;
      wbml:subjectMap ?sm ;
      wbml:predicateObjectMap ?pom .

  ?sm wbml:nodeTemplate ?subjectNodeTemplate .

  ?pom wbint:statID ?statID ;
       wbml:objectMap ?wom ;
       wbml:qualifierMap ?qmap .

  OPTIONAL { ?wom wbml:reference ?mainReference . }
  OPTIONAL { ?wom wbml:nodeTemplate ?mainValueNodeTemplate . }
  OPTIONAL { ?wom wbml:nodeId ?mainValueNodeId . }
  OPTIONAL { ?wom wbml:joinCondition / wbml:child ?childKey . }

  BIND(COALESCE(?mainValueNodeTemplate, ?mainValueNodeId) AS ?mainValueNode)

  ?qmap wbml:objectMap ?qom .

  OPTIONAL { ?qmap wbml:predicate ?qualifierPredicateNode . }
  OPTIONAL { ?qmap wbml:predicateId ?qualifierPredicateId . }
  FILTER(BOUND(?qualifierPredicateNode) || BOUND(?qualifierPredicateId))

  OPTIONAL { ?qualifierPredicateNode wbml:nodeTemplate ?qualExplicitKey . }
  FILTER(
    !BOUND(?qualifierPredicateNode) ||
    isBlank(?qualifierPredicateNode) ||
    STRSTARTS(STR(?qualifierPredicateNode), "https://example.org/wbml#")
  )

  ?qom wbml:parentTriplesMap ?parentTM .

  BIND(IRI(CONCAT(STR(?tm), "/statement/", STR(?statID))) AS ?stmtTM)
  BIND(IRI(CONCAT(STR(?stmtTM), "/subjectMap")) AS ?stmtSM)
  BIND(IRI(CONCAT(STR(?stmtTM), "/pom/qualifier/", ENCODE_FOR_URI(STR(?qmap)))) AS ?qualifierPOM)
  BIND(IRI(CONCAT(STR(?qualifierPOM), "/om")) AS ?qualifierOM)

  OPTIONAL {
    ?qom wbml:joinCondition ?jc .
    ?jc wbml:child ?childField ;
        wbml:parent ?parentField .
    BIND(IRI(CONCAT(STR(?qualifierOM), "/joinCondition/", ENCODE_FOR_URI(STR(?jc)))) AS ?joinNode)
  }

  BIND(
    IF(BOUND(?qualifierPredicateId),
      IRI(CONCAT("urn:wikibase:qualifierIRI:", STR(?qualifierPredicateId))),
      COALESCE(
        IRI(CONCAT("urn:wikibase:qualifier:", ?qualExplicitKey)),
        IRI(CONCAT("urn:wikibase:qualifier:", STRAFTER(STR(?qualifierPredicateNode), "#")))
      )
    ) AS ?qualifierPredIRI
  )

  BIND(
    IF(BOUND(?mainReference),       CONCAT("_{", STR(?mainReference), "}"),
    IF(BOUND(?mainValueNode), CONCAT("_", STR(?mainValueNode)),
    IF(BOUND(?childKey),            CONCAT("_{", STR(?childKey), "}"),
    "")))
  AS ?valueSuffix)
}
