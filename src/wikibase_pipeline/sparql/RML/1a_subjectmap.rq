PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX wbml: <https://example.org/wbml#>

CONSTRUCT {
  ?tm rr:subjectMap ?subjectMap .

  ?subjectMap rr:template ?template ;
              rr:termType rr:IRI ;
              rr:class ?classIRI .
}
WHERE {
  ?tm wbml:subjectMap ?sm .
  ?sm wbml:nodeTemplate ?nodeTemplate .

  OPTIONAL {
    ?sm wbml:classMap ?classNode .
    BIND(IRI(CONCAT("urn:wikibase:item:", STRAFTER(STR(?classNode), "#"))) AS ?classIRI)
  }

  BIND(IRI(CONCAT(STR(?tm), "/subjectMap")) AS ?subjectMap)
  BIND(CONCAT("urn:wikibase:item:", STR(?nodeTemplate)) AS ?template)
}
