PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX wbml: <https://example.org/wbml#>

CONSTRUCT {
  ?stmtTM a rr:TriplesMap ;
          rml:logicalSource ?ls ;
          rr:subjectMap ?stmtSM ;
          rr:predicateObjectMap ?subjectPOM ;
          rr:predicateObjectMap ?propertyPOM ;
          rr:predicateObjectMap ?valuePOM .

  ?stmtSM rr:template ?stmtTemplate ;
          rr:termType rr:IRI .

  ?subjectPOM rr:predicate wbml:statementSubject ;
              rr:objectMap ?subjectOM .

  ?subjectOM rr:template ?subjectTemplate ;
             rr:termType rr:IRI .

  ?propertyPOM rr:predicate wbml:statementProperty ;
               rr:objectMap ?propertyOM .

  ?propertyOM rr:constant ?predIRI .

  ?valuePOM rr:predicate wbml:statementValue ;
            rr:objectMap ?valueOM .

  ?valueOM rr:constant ?constant .
  ?valueOM rr:datatype ?datatype .
  ?valueOM rr:language ?language .
}
WHERE {
  ?tm a rr:TriplesMap ;
      rml:logicalSource ?ls ;
      wbml:subjectMap ?sm ;
      wbml:predicateObjectMap ?pom .

  ?sm wbml:nodeTemplate ?subjectNodeTemplate .

  ?pom wbml:predicate ?predicateNode ;
       wbml:statID ?statID ;
       wbml:objectMap ?wom .

  ?wom wbml:constant ?constant .
  OPTIONAL { ?wom wbml:datatype ?datatype . }
  OPTIONAL { ?wom wbml:language ?language . }

  OPTIONAL { ?predicateNode wbml:nodeTemplate ?predBlankKey . }

  FILTER(?predicateNode NOT IN (rdfs:label, rdfs:comment, skos:altLabel))

  BIND(IRI(CONCAT(STR(?tm), "/statement/", STR(?statID))) AS ?stmtTM)
  BIND(IRI(CONCAT(STR(?stmtTM), "/subjectMap")) AS ?stmtSM)

  BIND(IRI(CONCAT(STR(?stmtTM), "/pom/subject")) AS ?subjectPOM)
  BIND(IRI(CONCAT(STR(?subjectPOM), "/om")) AS ?subjectOM)

  BIND(IRI(CONCAT(STR(?stmtTM), "/pom/property")) AS ?propertyPOM)
  BIND(IRI(CONCAT(STR(?propertyPOM), "/om")) AS ?propertyOM)

  BIND(IRI(CONCAT(STR(?stmtTM), "/pom/value/", ENCODE_FOR_URI(STR(?wom)))) AS ?valuePOM)
  BIND(IRI(CONCAT(STR(?valuePOM), "/om")) AS ?valueOM)

  BIND(
    IF(isBlank(?predicateNode),
      IRI(CONCAT("urn:wikibase:property:", ?predBlankKey)),
      IF(STRSTARTS(STR(?predicateNode), "https://example.org/wbml#"),
        IRI(CONCAT("urn:wikibase:property:", STRAFTER(STR(?predicateNode), "#"))),
        ?predicateNode
      )
    ) AS ?predIRI
  )

  BIND(
    CONCAT("urn:wikibase:item:", STR(?subjectNodeTemplate)) AS ?subjectTemplate
  )

  BIND(
    CONCAT("urn:wikibase:statement:", STR(?subjectNodeTemplate), "_", STR(?statID)) AS ?stmtTemplate
  )
}
