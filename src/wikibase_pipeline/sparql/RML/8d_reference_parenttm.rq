PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>

PREFIX wbml: <https://example.org/wbml#>
PREFIX wbint: <https://example.org/wbint#>

CONSTRUCT {
  ?refTM a rr:TriplesMap ;
         rml:logicalSource ?ls ;
         rr:subjectMap ?refSM ;
         rr:predicateObjectMap ?recordPOM .

  ?refSM rr:template ?stmtRefTemplate ;
         rr:termType rr:IRI .

  ?recordPOM rr:predicate ?refPropIRI ;
             rr:objectMap ?recordOM .

  ?recordOM rr:parentTriplesMap ?parentTM .
  ?recordOM rr:joinCondition ?joinNode .
  ?joinNode rr:child ?childField ;
            rr:parent ?parentField .
}
WHERE {
  ?tm a rr:TriplesMap ;
      rml:logicalSource ?ls ;
      wbml:itemMap ?sm ;
      wbml:predicateObjectMap ?pom .

  ?sm wbml:nodeTemplate ?subjectNodeTemplate .

  ?pom wbint:statID ?statID ;
       wbml:valueMap ?wom ;
       wbml:referenceMap ?rmap .

  OPTIONAL { ?wom wbml:reference ?mainReference . }
  OPTIONAL { ?wom wbml:nodeTemplate ?mainValueNodeTemplate . }
  OPTIONAL { ?wom wbml:nodeId ?mainValueNodeId . }
  OPTIONAL { ?wom wbml:joinCondition / wbml:child ?childKey . }

  BIND(COALESCE(?mainValueNodeTemplate, ?mainValueNodeId) AS ?mainValueNode)

  ?rmap wbint:refId ?refId ;
        wbml:referenceRecord ?rrec .

  ?rrec wbml:valueMap ?rom .

  OPTIONAL { ?rrec wbml:propertyMap ?refPropertyNode . }
  OPTIONAL { ?rrec wbml:propertyId ?refPropertyId . }
  FILTER(BOUND(?refPropertyNode) || BOUND(?refPropertyId))

  OPTIONAL { ?refPropertyNode wbml:nodeTemplate ?refExplicitKey . }
  FILTER(
    !BOUND(?refPropertyNode) ||
    isBlank(?refPropertyNode) ||
    STRSTARTS(STR(?refPropertyNode), "https://example.org/wbml#")
  )

  ?rom wbml:parentTriplesMap ?parentTM .

  BIND(IRI(CONCAT(STR(?tm), "/statement/", STR(?statID), "/reference/", STR(?refId))) AS ?refTM)
  BIND(IRI(CONCAT(STR(?refTM), "/subjectMap")) AS ?refSM)
  BIND(IRI(CONCAT(STR(?refTM), "/pom/referenceRecord/", ENCODE_FOR_URI(STR(?rrec)))) AS ?recordPOM)
  BIND(IRI(CONCAT(STR(?recordPOM), "/om")) AS ?recordOM)

  OPTIONAL {
    ?rom wbml:joinCondition ?jc .
    ?jc wbml:child ?childField ;
        wbml:parent ?parentField .
    BIND(IRI(CONCAT(STR(?recordOM), "/joinCondition/", ENCODE_FOR_URI(STR(?jc)))) AS ?joinNode)
  }

  BIND(
    IF(BOUND(?refPropertyId),
      IRI(CONCAT("urn:wikibase:referenceIRI:", STR(?refPropertyId))),
      COALESCE(
        IRI(CONCAT("urn:wikibase:reference:", ?refExplicitKey)),
        IRI(CONCAT("urn:wikibase:reference:", STRAFTER(STR(?refPropertyNode), "#")))
      )
    ) AS ?refPropIRI
  )


  BIND(
    IF(BOUND(?mainReference),       CONCAT("_{", STR(?mainReference), "}"),
    IF(BOUND(?mainValueNode), CONCAT("_", STR(?mainValueNode)),
    IF(BOUND(?childKey),            CONCAT("_{", STR(?childKey), "}"),
    "")))
  AS ?valueSuffix)

  BIND(
    CONCAT(
      "urn:wikibase:statementreference:", STR(?subjectNodeTemplate), "_", STR(?statID),
      ?valueSuffix, "_", STR(?refId)
    )
    AS ?stmtRefTemplate
  )
}
