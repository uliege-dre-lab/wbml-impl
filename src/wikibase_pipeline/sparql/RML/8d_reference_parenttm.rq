PREFIX rr:   <http://www.w3.org/ns/r2rml#>
PREFIX rml:  <http://semweb.mmlab.be/ns/rml#>
PREFIX wbml: <https://example.org/wbml#>

CONSTRUCT {
  ?refTM a rr:TriplesMap ;
         rml:logicalSource ?ls ;
         rr:subjectMap ?refSM ;
         rr:predicateObjectMap ?recordPOM .

  ?refSM rr:template ?stmtRefTemplate ;
         rr:termType rr:IRI .

  ?recordPOM rr:predicate ?refPredIRI ;
             rr:objectMap ?recordOM .

  ?recordOM rr:parentTriplesMap ?parentTM .
  ?recordOM rr:joinCondition ?joinNode .
  ?joinNode rr:child ?childField ;
            rr:parent ?parentField .
}
WHERE {
  ?tm a rr:TriplesMap ;
      rml:logicalSource ?ls ;
      wbml:subjectMap ?sm ;
      wbml:predicateObjectMap ?pom .

  ?sm wbml:nodeId ?subjectNodeId .
  OPTIONAL { ?sm wbml:classKey ?subjectClassKey . }

  ?pom wbml:statID ?statID ;
       wbml:referenceMap ?rmap .

  ?rmap wbml:refId ?refId ;
        wbml:referenceRecord ?rrec .

  ?rrec wbml:predicateKey ?refPredicateKey ;
        wbml:objectMap ?rom .

  ?rom wbml:parentTriplesMap ?parentTM .

  BIND(IRI(CONCAT(STR(?tm), "/statement/", STR(?statID), "/reference/", STR(?refId))) AS ?refTM)
  BIND(IRI(CONCAT(STR(?refTM), "/subjectMap")) AS ?refSM)
  BIND(IRI(CONCAT(STR(?refTM), "/pom/referenceRecord/", ENCODE_FOR_URI(STR(?rrec)))) AS ?recordPOM)
  BIND(IRI(CONCAT(STR(?recordPOM), "/om")) AS ?recordOM)

  OPTIONAL {
    ?rom wbml:joinCondition ?jc .
    ?jc wbml:child ?childField ;
        wbml:parent ?parentField .
    BIND(IRI(CONCAT(STR(?recordOM), "/joinCondition/", ENCODE_FOR_URI(STR(?jc)))) AS ?joinNode)
  }

  BIND(IRI(CONCAT("urn:wikibase:reference:", STR(?refPredicateKey))) AS ?refPredIRI)

  BIND(
    IF(
      BOUND(?subjectClassKey),
      CONCAT("urn:wikibase:statementreference:", STR(?subjectClassKey), "_{", STR(?subjectNodeId), "}_", STR(?statID), "_", STR(?refId)),
      CONCAT("urn:wikibase:statementreference:{", STR(?subjectNodeId), "}_", STR(?statID), "_", STR(?refId))
    ) AS ?stmtRefTemplate
  )
}
