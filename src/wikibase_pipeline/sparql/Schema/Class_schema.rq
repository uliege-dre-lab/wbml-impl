PREFIX wbml: <https://example.org/wbml#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
  ?classIRI a wbml:Class ;
            rdfs:label       ?classLabel ;
            rdfs:comment     ?classDescription ;
            rdfs:subClassOf  ?parentClassIRI ;
            skos:altLabel    ?classAlias .
}
WHERE {
  ?classNode a rdfs:Class .

  OPTIONAL { ?classNode rdfs:label      ?classLabel . }
  OPTIONAL { ?classNode rdfs:comment    ?classDescription . }
  OPTIONAL { ?classNode skos:altLabel   ?classAlias . }

  BIND(IRI(CONCAT("urn:wikibase:item:", STRAFTER(STR(?classNode), "#"))) AS ?classIRI)

  OPTIONAL {
    ?classNode rdfs:subClassOf ?parentClassNode .
    BIND(IRI(CONCAT("urn:wikibase:item:", STRAFTER(STR(?parentClassNode), "#"))) AS ?parentClassIRI)
  }
}
