PREFIX wbml: <https://example.org/wbml#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
  ?classIRI a rdfs:Class ;
            rdfs:label       ?classLabel ;
            rdfs:comment     ?classDescription ;
            rdfs:subClassOf  ?parentClassIRI ;
            skos:altLabel    ?classAlias .
}
WHERE {
  ?classNode a rdfs:Class .

  OPTIONAL { ?classNode rdfs:label        ?classLabel . }
  OPTIONAL { ?classNode rdfs:comment      ?classDescription . }
  OPTIONAL { ?classNode skos:altLabel     ?classAlias . }
  OPTIONAL { ?classNode wbml:nodeTemplate ?classExplicitKey . }

  BIND(COALESCE(?classExplicitKey, STRAFTER(STR(?classNode), "#")) AS ?classKey)

  BIND(IRI(CONCAT("urn:wikibase:item:", ?classKey)) AS ?classIRI)

  OPTIONAL { ?parentClassNode wbml:nodeTemplate ?parentExplicitKey . }
  BIND(COALESCE(?parentExplicitKey, STRAFTER(STR(?parentClassNode), "#")) AS ?parentKey)
}
