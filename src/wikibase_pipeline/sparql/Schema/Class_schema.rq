CONSTRUCT {
  ?classIRI a wbml:Class ;
            wbml:entityLabel      ?classLabel ;
            wbml:entityDescription ?classDescription ;
            wbml:entityAlias      ?classAlias ;
            wbml:subclassOf       ?parentClassIRI .
}
WHERE {
  {
    { ?classNode a wbml:Class . }
    UNION
    { [] wbml:class ?classNode . }
  }

  OPTIONAL { ?classNode wbml:entityLabel       ?classLabel . }
  OPTIONAL { ?classNode wbml:entityDescription ?classDescription . }
  OPTIONAL { ?classNode wbml:entityAlias       ?classAlias . }
  OPTIONAL { ?classNode wbml:nodeTemplate      ?classExplicitKey . }

  BIND(COALESCE(?classExplicitKey, STRAFTER(STR(?classNode), "#")) AS ?classKey)
  BIND(IRI(CONCAT("urn:wikibase:item:", ?classKey)) AS ?classIRI)

  OPTIONAL {
    ?classNode wbml:subclassOf ?parentClassNode .
    OPTIONAL { ?parentClassNode wbml:nodeTemplate ?parentExplicitKey . }
    BIND(COALESCE(?parentExplicitKey, STRAFTER(STR(?parentClassNode), "#")) AS ?parentKey)
    BIND(IRI(CONCAT("urn:wikibase:item:", ?parentKey)) AS ?parentClassIRI)
  }
}
