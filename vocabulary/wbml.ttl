@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix wbml: <https://example.org/wbml#> .
@prefix wbint: <https://example.org/wbint#> .
@prefix rml:   <http://w3id.org/rml/> .

#################################################################
# Ontology declaration
#################################################################

<https://example.org/wbml>
    a owl:Ontology ;
    rdfs:label "Wikibase Mapping Language (WBML) Vocabulary"@en ;
    rdfs:comment "Vocabulary for the Wikibase Mapping Language, an RML-compatible mapping language that supports Wikibase-specific features such as statements, qualifiers, references, and ranks."@en .

<https://example.org/wbint>
    a owl:Ontology ;
    rdfs:label "WBML Internal Vocabulary"@en ;
    rdfs:comment "Internal computed properties assigned by the WBML-to-RML conversion pipeline. Not intended for use in WBML mapping files."@en .

#################################################################
# Classes
#################################################################

wbml:EntityMap
    a owl:Class ;
    rdfs:label "Entity Map"@en ;
    rdfs:comment "Describes how to generate the Wikibase entity (subject) for each row of input data."@en .

wbml:StatementMap
    a owl:Class ;
    rdfs:label "Statement Map"@en ;
    rdfs:comment "Maps a source data field to a Wikibase statement (property + value), optionally with qualifiers, references, and a rank."@en .

wbml:ValueMap
    a owl:Class ;
    rdfs:label "Value Map"@en ;
    rdfs:comment "Describes how to generate the value for a statement, qualifier, or reference."@en .

wbml:QualifierMap
    a owl:Class ;
    rdfs:label "Qualifier Map"@en ;
    rdfs:comment "Maps a source data field to a Wikibase qualifier on a statement."@en .

wbml:ReferenceMap
    a owl:Class ;
    rdfs:label "Reference Map"@en ;
    rdfs:comment "Groups one or more reference records into a single Wikibase reference block on a statement."@en .

wbml:ReferenceRecord
    a owl:Class ;
    rdfs:label "Reference Record"@en ;
    rdfs:comment "A single property-value pair within a Wikibase reference block."@en .

wbml:JoinCondition
    a owl:Class ;
    rdfs:label "Join Condition"@en ;
    rdfs:comment "Specifies a join between a child field and a parent field when linking to another triples map."@en .

wbml:Rank
    a owl:Class ;
    rdfs:label "Rank"@en ;
    rdfs:comment "The rank of a Wikibase statement (preferred, normal, or deprecated)."@en .

wbml:Class
    a owl:Class ;
    rdfs:label "class"@en ;
    rdfs:comment "A Wikibase class in the schema."@en .

#################################################################
# Entity declaration properties - used in schema declarations
#################################################################

wbml:entityLabel
    a owl:AnnotationProperty ;
    rdfs:label "entity label"@en ;
    rdfs:comment "A human-readable label for a declared Wikibase class or property, optionally language-tagged. Replaces rdfs:label in WBML schema declarations."@en ;
    rdfs:domain [ owl:unionOf (wbml:Class wbml:Property) ] .

wbml:entityDescription
    a owl:AnnotationProperty ;
    rdfs:label "entity description"@en ;
    rdfs:comment "A human-readable description for a declared Wikibase class or property, optionally language-tagged. Replaces rdfs:comment in WBML schema declarations."@en ;
    rdfs:domain [ owl:unionOf (wbml:Class wbml:Property) ] .

wbml:entityAlias
    a owl:AnnotationProperty ;
    rdfs:label "entity alias"@en ;
    rdfs:comment "An alternative label for a declared Wikibase class or property, optionally language-tagged. Replaces skos:altLabel in WBML schema declarations."@en ;
    rdfs:domain [ owl:unionOf (wbml:Class wbml:Property) ] .

#################################################################
# Entity declaration properties - used in schema declarations
#################################################################

wbml:entityLabel
    a owl:AnnotationProperty ;
    rdfs:label "entity label"@en ;
    rdfs:comment "A human-readable label for a declared Wikibase class or property, optionally language-tagged. Replaces rdfs:label in WBML schema declarations."@en ;
    rdfs:domain [ owl:unionOf (wbml:Class wbml:Property) ] .

wbml:entityDescription
    a owl:AnnotationProperty ;
    rdfs:label "entity description"@en ;
    rdfs:comment "A human-readable description for a declared Wikibase class or property, optionally language-tagged. Replaces rdfs:comment in WBML schema declarations."@en ;
    rdfs:domain [ owl:unionOf (wbml:Class wbml:Property) ] .

wbml:entityAlias
    a owl:AnnotationProperty ;
    rdfs:label "entity alias"@en ;
    rdfs:comment "An alternative label for a declared Wikibase class or property, optionally language-tagged. Replaces skos:altLabel in WBML schema declarations."@en ;
    rdfs:domain [ owl:unionOf (wbml:Class wbml:Property) ] .

#################################################################
# Named individuals — ranks and special types
#################################################################

wbml:PreferredRank
    a wbml:Rank, owl:NamedIndividual ;
    rdfs:label "Preferred Rank"@en ;
    rdfs:comment "Marks a statement as having preferred rank in Wikibase."@en .

wbml:NormalRank
    a wbml:Rank, owl:NamedIndividual ;
    rdfs:label "Normal Rank"@en ;
    rdfs:comment "Marks a statement as having normal rank in Wikibase (default)."@en .

wbml:DeprecatedRank
    a wbml:Rank, owl:NamedIndividual ;
    rdfs:label "Deprecated Rank"@en ;
    rdfs:comment "Marks a statement as having deprecated rank in Wikibase."@en .

wbml:Item
    a owl:NamedIndividual ;
    rdfs:label "Item"@en ;
    rdfs:comment "Used as the value of wbml:entityType to indicate that the entity map generates a Wikibase item (default when entityType is absent)."@en .

wbml:Property
    a owl:Class, owl:NamedIndividual ;
    rdfs:label "Property"@en ;
    rdfs:comment "A Wikibase property in the schema. As a named individual: value of wbml:entityType to indicate the entity map generates a Wikibase property."@en .

#################################################################
# Property datatype individuals - values for wbml:propertyType
#################################################################

wbml:item
    a owl:NamedIndividual ;
    rdfs:label "item"@en ;
    rdfs:comment "Value of wbml:propertyType: the property has Wikibase datatype 'wikibase-item' (links to another item)."@en .

wbml:string
    a owl:NamedIndividual ;
    rdfs:label "string"@en ;
    rdfs:comment "Value of wbml:propertyType: the property has Wikibase datatype 'string'."@en .

wbml:url
    a owl:NamedIndividual ;
    rdfs:label "url"@en ;
    rdfs:comment "Value of wbml:propertyType: the property has Wikibase datatype 'url'."@en .

wbml:externalId
    a owl:NamedIndividual ;
    rdfs:label "external ID"@en ;
    rdfs:comment "Value of wbml:propertyType: the property has Wikibase datatype 'external-id'."@en .

wbml:quantity
    a owl:NamedIndividual ;
    rdfs:label "quantity"@en ;
    rdfs:comment "Value of wbml:propertyType: the property has Wikibase datatype 'quantity'."@en .

wbml:time
    a owl:NamedIndividual ;
    rdfs:label "time"@en ;
    rdfs:comment "Value of wbml:propertyType: the property has Wikibase datatype 'time'."@en .

wbml:monolingualText
    a owl:NamedIndividual ;
    rdfs:label "monolingual text"@en ;
    rdfs:comment "Value of wbml:propertyType: the property has Wikibase datatype 'monolingualtext'."@en .

#################################################################
# Entity map properties
#################################################################

wbml:entityMap
    a owl:ObjectProperty ;
    rdfs:label "entity map"@en ;
    rdfs:comment "Attaches an entity map to a triples map, defining how the Wikibase entity identifier is generated. Defaults to generating a Wikibase item unless wbml:entityType specifies otherwise."@en ;
    rdfs:domain rml:TriplesMap ;
    rdfs:range wbml:EntityMap .

wbml:entityTemplate
    a owl:DatatypeProperty ;
    rdfs:label "entity template"@en ;
    rdfs:comment "A template string (with {variable} placeholders) used to construct the Wikibase entity identifier."@en ;
    rdfs:domain [ owl:unionOf (wbml:EntityMap wbml:ValueMap) ] ;
    rdfs:range xsd:string .

wbml:entityId
    a owl:DatatypeProperty ;
    rdfs:label "entity ID"@en ;
    rdfs:comment "A known Wikibase entity ID used to directly reference an existing item or property, instead of deriving its IRI from a template."@en ;
    rdfs:domain [ owl:unionOf (wbml:EntityMap wbml:ValueMap) ] ;
    rdfs:range xsd:string .


wbml:class
    a owl:ObjectProperty ;
    rdfs:label "class"@en ;
    rdfs:comment "Specifies the Wikibase class that the generated entity should be an instance of."@en ;
    rdfs:domain [ owl:unionOf (wbml:EntityMap wbml:ValueMap) ] ;
    rdfs:range wbml:Class .

wbml:classId
    a owl:DatatypeProperty ;
    rdfs:label "class ID"@en ;
    rdfs:comment "A known Wikibase item ID for the class used to directly reference an existing class instead of resolving it from a spec node."@en ;
    rdfs:domain wbml:EntityMap ;
    rdfs:range xsd:string .

wbml:entityType
    a owl:ObjectProperty ;
    rdfs:label "entity type"@en ;
    rdfs:comment "Specifies whether the entity map generates a Wikibase item (wbml:Item, default) or property (wbml:Property)."@en ;
    rdfs:domain wbml:EntityMap ;
    rdfs:range [ owl:unionOf (wbml:Item wbml:Property) ] .

wbml:propertyType
    a owl:ObjectProperty ;
    rdfs:label "property type"@en ;
    rdfs:comment "Specifies the Wikibase datatype of a property."@en ;
    rdfs:domain [ owl:unionOf (wbml:Property wbml:EntityMap) ] ;
    rdfs:range [ owl:unionOf (wbml:item wbml:string wbml:url wbml:externalId wbml:quantity wbml:time wbml:monolingualText) ] .

#################################################################
# Statement map properties
#################################################################

wbml:statementMap
    a owl:ObjectProperty ;
    rdfs:label "statement map"@en ;
    rdfs:comment "Attaches a statement map to a triples map, defining a Wikibase statement to generate."@en ;
    rdfs:domain rml:TriplesMap ;
    rdfs:range wbml:StatementMap .

wbml:label
    a owl:ObjectProperty ;
    rdfs:label "label"@en ;
    rdfs:comment "Relating a label to an Entity's fingerprint. The blank node holds only a wbml:valueMap."@en ;
    rdfs:domain rml:TriplesMap ;
    rdfs:range wbml:ValueMap .

wbml:description
    a owl:ObjectProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "Relating a description to an Entity's fingerprint. The blank node holds only a wbml:valueMap."@en ;
    rdfs:domain rml:TriplesMap ;
    rdfs:range wbml:ValueMap .

wbml:alias
    a owl:ObjectProperty ;
    rdfs:label "alias"@en ;
    rdfs:comment "Relating an alias to an Entity's fingerprint. The blank node holds only a wbml:valueMap."@en ;
    rdfs:domain rml:TriplesMap ;
    rdfs:range wbml:ValueMap .

wbml:propertyMap
    a owl:ObjectProperty ;
    rdfs:label "property map"@en ;
    rdfs:comment "Specifies an inline blank-node property definition for a statement, qualifier, or reference."@en ;
    rdfs:domain [ owl:unionOf (wbml:StatementMap wbml:QualifierMap wbml:ReferenceRecord) ] ;
    rdfs:range wbml:Property .

wbml:propertyId
    a owl:DatatypeProperty ;
    rdfs:label "property ID"@en ;
    rdfs:comment "A known Wikibase property ID used to directly reference an existing property, instead of defining it with a PredicateSpec."@en ;
    rdfs:domain [ owl:unionOf (wbml:StatementMap wbml:QualifierMap wbml:ReferenceRecord) ] ;
    rdfs:range xsd:string .

wbml:property
    a owl:ObjectProperty ;
    rdfs:label "property"@en ;
    rdfs:comment "References an existing named property IRI for a statement, qualifier, or reference."@en ;
    rdfs:domain [ owl:unionOf (wbml:StatementMap wbml:QualifierMap wbml:ReferenceRecord) ] .

wbml:valueMap
    a owl:ObjectProperty ;
    rdfs:label "value map"@en ;
    rdfs:comment "Describes how to generate the value of a statement, qualifier, or reference."@en ;
    rdfs:domain [ owl:unionOf (wbml:StatementMap wbml:QualifierMap wbml:ReferenceRecord) ] ;
    rdfs:range wbml:ValueMap .

wbml:rank
    a owl:ObjectProperty ;
    rdfs:label "rank"@en ;
    rdfs:comment "The Wikibase rank to assign to a generated statement."@en ;
    rdfs:domain wbml:StatementMap ;
    rdfs:range wbml:Rank .

wbml:qualifierMap
    a owl:ObjectProperty ;
    rdfs:label "qualifier map"@en ;
    rdfs:comment "Attaches a qualifier map to a predicate-object map."@en ;
    rdfs:domain wbml:StatementMap ;
    rdfs:range wbml:QualifierMap .

wbml:referenceMap
    a owl:ObjectProperty ;
    rdfs:label "reference map"@en ;
    rdfs:comment "Attaches a reference map to a predicate-object map, grouping reference records into one Wikibase reference block."@en ;
    rdfs:domain wbml:StatementMap ;
    rdfs:range wbml:ReferenceMap .

#################################################################
# Value map properties
#################################################################

wbml:reference
    a owl:DatatypeProperty ;
    rdfs:label "reference"@en ;
    rdfs:comment "A JSONPath or SQL column reference to the source data field whose value populates the object."@en ;
    rdfs:domain wbml:ValueMap ;
    rdfs:range xsd:string .

wbml:constant
    a owl:DatatypeProperty ;
    rdfs:label "constant"@en ;
    rdfs:comment "A literal constant value to use as the object, independent of the source data."@en ;
    rdfs:domain wbml:ValueMap .

wbml:language
    a owl:DatatypeProperty ;
    rdfs:label "language"@en ;
    rdfs:comment "BCP 47 language tag to attach to the generated string literal."@en ;
    rdfs:domain wbml:ValueMap ;
    rdfs:range xsd:string .

wbml:datatype
    a owl:ObjectProperty ;
    rdfs:label "datatype"@en ;
    rdfs:comment "The XSD datatype to use when constructing the typed literal for the object."@en ;
    rdfs:domain wbml:ValueMap ;
    rdfs:range rdfs:Datatype .

wbml:parentTriplesMap
    a owl:ObjectProperty ;
    rdfs:label "parent triples map"@en ;
    rdfs:comment "References another triples map to join with, creating an item-valued object via a foreign-key relationship."@en ;
    rdfs:domain wbml:ValueMap ;
    rdfs:range rml:TriplesMap .

wbml:joinCondition
    a owl:ObjectProperty ;
    rdfs:label "join condition"@en ;
    rdfs:comment "Specifies the child and parent fields to use when joining with a parent triples map."@en ;
    rdfs:domain wbml:ValueMap ;
    rdfs:range wbml:JoinCondition .

wbml:template
    a owl:DatatypeProperty ;
    rdfs:label "template"@en ;
    rdfs:comment "A template string with {variable} placeholders that generates a literal string value by substituting source data fields."@en ;
    rdfs:domain wbml:ValueMap ;
    rdfs:range xsd:string .

#################################################################
# Join condition properties
#################################################################

wbml:child
    a owl:DatatypeProperty ;
    rdfs:label "child"@en ;
    rdfs:comment "The field name in the child (current) logical source to use in a join condition."@en ;
    rdfs:domain wbml:JoinCondition ;
    rdfs:range xsd:string .

wbml:parent
    a owl:DatatypeProperty ;
    rdfs:label "parent"@en ;
    rdfs:comment "The field name in the parent logical source to use in a join condition."@en ;
    rdfs:domain wbml:JoinCondition ;
    rdfs:range xsd:string .

#################################################################
# Reference map properties
#################################################################

wbml:referenceRecord
    a owl:ObjectProperty ;
    rdfs:label "reference record"@en ;
    rdfs:comment "A single property-value pair within a reference map."@en ;
    rdfs:domain wbml:ReferenceMap ;
    rdfs:range wbml:ReferenceRecord .

#################################################################
# Schema-level properties (used by Schema SPARQL queries)
#################################################################

wbml:subclassOf
    a owl:ObjectProperty ;
    rdfs:label "subclass of"@en ;
    rdfs:comment "Asserts a subclass relationship between two Wikibase classes in the generated schema."@en ;
    rdfs:domain wbml:Class ;
    rdfs:range wbml:Class .

#################################################################
# Internal/computed properties (used by the converter pipeline)
#################################################################

wbint:statID
    a owl:DatatypeProperty ;
    rdfs:label "statement ID"@en ;
    rdfs:comment "An internally assigned integer identifier for a predicate-object map, used during RML conversion."@en ;
    rdfs:domain wbml:StatementMap ;
    rdfs:range xsd:integer .

wbint:refId
    a owl:DatatypeProperty ;
    rdfs:label "reference ID"@en ;
    rdfs:comment "An internally assigned integer identifier for a reference map within a predicate-object map, used during RML conversion."@en ;
    rdfs:domain wbml:ReferenceMap ;
    rdfs:range xsd:integer .

wbml:statementSubject
    a owl:ObjectProperty ;
    rdfs:label "statement subject"@en ;
    rdfs:comment "Internal property linking a generated RML statement node back to its subject triples map."@en .

wbml:statementProperty
    a owl:ObjectProperty ;
    rdfs:label "statement property"@en ;
    rdfs:comment "Internal property linking a generated RML statement node to its property."@en .

wbml:statementValue
    a owl:ObjectProperty ;
    rdfs:label "statement value"@en ;
    rdfs:comment "Internal property linking a generated RML statement node to its value."@en .

wbml:statementReference
    a owl:ObjectProperty ;
    rdfs:label "statement reference"@en ;
    rdfs:comment "Internal property linking a generated RML statement node to a reference block."@en .
