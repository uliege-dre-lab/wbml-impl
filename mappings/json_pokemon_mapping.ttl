<#PokedexMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:source "data/input/json_pokemon/pokedex.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:entity:Pokemon_{id}" ;
    rr:termType rr:IRI ;
    rr:class wd:Pokemon
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "name.english" ;
      rr:language "en"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "name.japanese" ;
      rr:language "ja"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "name.chinese" ;
      rr:language "zh"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "name.french" ;
      rr:language "fr"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:PokedexNumber ;
    rr:objectMap [
      rml:reference "id" ;
      rr:datatype xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:HasSpecies ;
    rr:objectMap [
      rr:template "urn:wikibase:entity:Species_{species}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:Description ;
    rr:objectMap [
      rml:reference "description" ;
      rr:datatype xsd:string
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:HP ;
    rr:objectMap [
      rml:reference "base.HP" ;
      rr:datatype xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:Attack ;
    rr:objectMap [
      rml:reference "base.Attack" ;
      rr:datatype xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:Defense ;
    rr:objectMap [
      rml:reference "base.Defense" ;
      rr:datatype xsd:integer
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate wdt:SpecialAttack ;
    rr:objectMap [
      rml:reference "base.Sp. Attack" ;
      rr:datatype
      xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:SpecialDefense;
    rr:objectMap [
      rml:reference "base.Sp. Defense" ;
      rr:datatype xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:Speed ;
    rr:objectMap [
      rml:reference "base.Speed" ;
      rr:datatype xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:HasType ;
    rr:objectMap [
      rr:template "urn:wikibase:entity:Type_{type}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:Height ;
    rr:objectMap [
      rml:reference "profile.height" ;
      rr:datatype xsd:string
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:Weight ;
    rr:objectMap [
      rml:reference "profile.weight" ;
      rr:datatype xsd:string
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:Gender ;
    rr:objectMap [
      rml:reference "profile.gender" ;
      rr:datatype xsd:string
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:Sprite ;
    rr:objectMap [
      rml:reference "image.sprite" ;
      rr:datatype xsd:anyURI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:Thumbnail ;
    rr:objectMap [
      rml:reference "image.thumbnail" ;
      rr:datatype xsd:anyURI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:Hires ;
    rr:objectMap [
      rml:reference "image.hires" ;
      rr:datatype xsd:anyURI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:HasEggGroup ;
    rr:objectMap [
      rr:template "urn:wikibase:entity:EggGroup_{profile.egg}" ;
      rr:termType rr:IRI
    ]
  ] .


