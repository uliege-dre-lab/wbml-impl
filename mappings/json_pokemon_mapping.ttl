<#PokedexMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:source "data/input/json_pokemon/pokedex.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:item:Pokemon_{id}" ;
    rr:termType rr:IRI ;
    rr:class wb:Pokemon
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "name.english" ;
      rr:language "en"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "name.japanese" ;
      rr:language "ja"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "name.chinese" ;
      rr:language "zh"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "name.french" ;
      rr:language "fr"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:PokedexNumber ;
    rr:objectMap [
      rml:reference "id" ;
      rr:datatype xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:HasSpecies ;
    rr:objectMap [
      rr:template "urn:wikibase:item:Species_{species}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:comment ;
    rr:objectMap [
      rml:reference "description" ;
      rr:datatype xsd:string
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:HP ;
    rr:objectMap [
      rml:reference "base.HP" ;
      rr:datatype xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:Attack ;
    rr:objectMap [
      rml:reference "base.Attack" ;
      rr:datatype xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:Defense ;
    rr:objectMap [
      rml:reference "base.Defense" ;
      rr:datatype xsd:integer
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate wbt:SpecialAttack ;
    rr:objectMap [
      rml:reference "base.Sp. Attack" ;
      rr:datatype
      xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:SpecialDefense;
    rr:objectMap [
      rml:reference "base.Sp. Defense" ;
      rr:datatype xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:Speed ;
    rr:objectMap [
      rml:reference "base.Speed" ;
      rr:datatype xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:HasType ;
    rr:objectMap [
      rr:template "urn:wikibase:item:Type_{type}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:Height ;
    rr:objectMap [
      rml:reference "profile.height" ;
      rr:datatype xsd:string
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:Weight ;
    rr:objectMap [
      rml:reference "profile.weight" ;
      rr:datatype xsd:string
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:Gender ;
