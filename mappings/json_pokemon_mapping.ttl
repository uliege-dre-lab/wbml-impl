@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

@prefix wikibase: <http://wikiba.se/ontology#> .

@prefix wb:         <urn:wikibase:item:> .
@prefix wbs:        <urn:wikibase:statement:> .
@prefix wbt:        <urn:wikibase:property:> .
@prefix wbq:        <urn:wikibase:qualifier:> .
@prefix wbref:      <urn:wikibase:reference:> .
@prefix wbrefnode:  <urn:wikibase:reference-node:> .

<#TypeMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:source "data/input/json_pokemon/types.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:item:Type_{english}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
      rr:constant wb:PokemonType
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "english" ;
      rr:language "en"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "chinese" ;
      rr:language "zh"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "japanese" ;
      rr:language "ja"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:EffectiveAgainst ;
    rr:objectMap [
      rr:template "urn:wikibase:item:Type_{effective}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:IneffectiveAgainst ;
    rr:objectMap [
      rr:template "urn:wikibase:item:Type_{ineffective}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:NoEffectAgainst ;
    rr:objectMap [
      rr:template "urn:wikibase:item:Type_{no_effect}" ;
      rr:termType rr:IRI
    ]
  ] .

<#ItemMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:source "data/input/json_pokemon/items.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:item:Item_{id}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
        rr:constant wb:Item
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
        rml:reference "name.english" ;
        rr:language "en"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
        rml:reference "name.chinese" ;
        rr:language "zh"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
        rml:reference "name.japanese" ;
        rr:language "ja"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:HasCategory ;
    rr:objectMap [
      rr:template "urn:wikibase:item:ItemCategory_{type}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:comment ;
    rr:objectMap [
        rml:reference "description"
    ]
  ] .

