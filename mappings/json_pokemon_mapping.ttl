<#PokemonAbilityLinkMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        json_extract_string(ability_entry, '$[0]') AS ability_name
      FROM read_json('data/input/json_pokemon/pokedex.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:item:Pokemon_{id}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:HasAbility ;
    rr:objectMap [
      rr:template "urn:wikibase:statement:Pokemon_{id}_Ability_{ability_name}" ;
      rr:termType rr:IRI
    ]
  ] .

<#AbilityMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        json_extract_string(ability_entry, '$[0]') AS ability_name
      FROM read_json('data/input/json_pokemon/pokedex.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:item:Ability_{ability_name}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
      rr:constant wb:Ability
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "ability_name"
    ]
  ] .

<#PokemonAbilityStatementMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        json_extract_string(ability_entry, '$[0]') AS ability_name,
        json_extract_string(ability_entry, '$[1]') AS ability_flag
      FROM read_json('data/input/json_pokemon/pokedex.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:statement:Pokemon_{id}_Ability_{ability_name}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
      rr:constant wikibase:Statement
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wikibase:rank ;
    rr:objectMap [
      rr:constant wikibase:PreferredRank
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:HasAbility ;
    rr:objectMap [
      rr:template "urn:wikibase:item:Ability_{ability_name}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbq:IsHiddenAbility ;
    rr:objectMap [
      rml:reference "ability_flag" ;
      rr:datatype xsd:boolean
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbref:StatedIn ;
    rr:objectMap [
      rr:constant "Pokedex" ;
      rr:datatype xsd:string
    ]
  ] .

<#PokemonEvolutionNextLinkMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        next_evo[0]::VARCHAR AS next_id
      FROM read_json('data/input/json_pokemon/pokedex.json'),
           unnest(evolution.next) AS t(next_evo)
      WHERE evolution.next IS NOT NULL
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:item:Pokemon_{id}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:EvolvesTo ;
    rr:objectMap [
      rr:template "urn:wikibase:statement:Pokemon_{id}_NextEvolution_{next_id}" ;
      rr:termType rr:IRI
    ]
  ] .

<#PokemonNextEvolutionStatementMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        next_evo,
        json_extract_string(next_evo, '$[0]') AS next_id,
        json_extract_string(next_evo, '$[1]') AS condition
      FROM read_json('data/input/json_pokemon/pokedex.json'),
          unnest(evolution.next) AS t(next_evo)
      WHERE evolution.next IS NOT NULL;
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:statement:Pokemon_{id}_NextEvolution_{next_id}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
      rr:constant wikibase:Statement
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:EvolvesTo ;
    rr:objectMap [
      rr:template "urn:wikibase:item:Pokemon_{next_id}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbq:EvolutionCondition ;
    rr:objectMap [
      rml:reference "condition" ;
      rr:datatype xsd:string
    ]
  ] .

