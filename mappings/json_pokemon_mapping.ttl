<#PokemonAbilityLinkMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        profile.ability[1] AS ability_name
      FROM read_json('data/input/json_pokemon/pokedex.json')
      WHERE profile.ability IS NOT NULL
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:entity:Pokemon_{id}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:HasAbility ;
    rr:objectMap [
      rr:template "urn:wikibase:statement:Pokemon_{id}_Ability_{ability_name}" ;
      rr:termType rr:IRI
    ]
  ] .

<#AbilityMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        profile.ability[1] AS ability_name
      FROM read_json('data/input/json_pokemon/pokedex.json')
      WHERE profile.ability IS NOT NULL
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:entity:Ability_{ability_name}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
      rr:constant wd:Ability
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "ability_name"
    ]
  ] .

<#PokemonAbilityStatementMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        profile.ability[1] AS ability_name,
        profile.ability[2] AS ability_flag
      FROM read_json('data/input/json_pokemon/pokedex.json')
      WHERE profile.ability IS NOT NULL
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:statement:Pokemon_{id}_Ability_{ability_name}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
      rr:constant wikibase:Statement
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wikibase:rank ;
    rr:objectMap [
      rr:constant wikibase:PreferredRank
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:HasAbility ;
    rr:objectMap [
      rr:template "urn:wikibase:entity:Ability_{ability_name}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdq:IsHiddenAbility ;
    rr:objectMap [
      rml:reference "ability_flag" ;
      rr:datatype xsd:boolean
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdref:StatedIn ;
    rr:objectMap [
      rr:constant "Pokedex" ;
      rr:datatype xsd:string
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdref:StatedIn ;
    rr:objectMap [
      rr:template "urn:wikibase:entity:Source_Pokedex" ;
      rr:termType rr:IRI
    ]
  ] .

<#PokemonEvolutionNextLinkMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        next_evo[0]::VARCHAR AS next_id
      FROM read_json('data/input/json_pokemon/pokedex.json'),
           unnest(evolution.next) AS t(next_evo)
      WHERE evolution.next IS NOT NULL
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:entity:Pokemon_{id}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:EvolvesTo ;
    rr:objectMap [
      rr:template "urn:wikibase:statement:Pokemon_{id}_NextEvolution_{next_id}" ;
      rr:termType rr:IRI
    ]
  ] .

<#PokemonNextEvolutionStatementMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        next_evo[0]::VARCHAR AS next_id,
        next_evo[1]::VARCHAR AS condition
      FROM read_json('data/input/json_pokemon/pokedex.json'),
           unnest(evolution.next) AS t(next_evo)
      WHERE evolution.next IS NOT NULL
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:statement:Pokemon_{id}_NextEvolution_{next_id}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
      rr:constant wikibase:Statement
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:EvolvesTo ;
    rr:objectMap [
      rr:template "urn:wikibase:entity:Pokemon_{next_id}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdq:EvolutionCondition ;
    rr:objectMap [
      rml:reference "condition" ;
      rr:datatype xsd:string
    ]
  ] .

