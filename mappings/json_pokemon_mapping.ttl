@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

@prefix wikibase: <http://wikiba.se/ontology#> .

@prefix wd:    <urn:wikibase:entity:> .
@prefix wds:   <urn:wikibase:statement:> .
@prefix wdt:   <urn:wikibase:prop:> .
@prefix wdq:   <urn:wikibase:qualifier:> .
@prefix wdref: <urn:wikibase:reference:> .

<#TypeMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:source "data/input/json_pokemon/types.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:entity:Type_{english}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
        rr:constant wd:PokemonType
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
        rml:reference "english" ;
        rr:language "en"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
        rml:reference "chinese" ;
        rr:language "zh"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
        rml:reference "japanese" ;
        rr:language "ja"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:EffectiveAgainst ;
    rr:objectMap [
      rr:template "urn:wikibase:entity:Type_{effective}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:IneffectiveAgainst ;
    rr:objectMap [
      rr:template "urn:wikibase:entity:Type_{ineffective}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wdt:NoEffectAgainst ;
    rr:objectMap [
      rr:template "urn:wikibase:entity:Type_{no_effect}" ;
      rr:termType rr:IRI
    ]
  ] .

