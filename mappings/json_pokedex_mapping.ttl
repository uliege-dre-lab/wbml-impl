@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

@prefix wikibase: <http://wikiba.se/ontology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

@prefix wb:         <urn:wikibase:item:> .
@prefix wbs:        <urn:wikibase:statement:> .
@prefix wbt:        <urn:wikibase:property:> .
@prefix wbq:        <urn:wikibase:qualifier:> .
@prefix wbref:      <urn:wikibase:reference:> .
@prefix wbrefnode:  <urn:wikibase:reference-node:> .

<#PokedexMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:source "data/input/json_pokemon/pokedex_small.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:item:Pokemon_{id}" ;
    rr:termType rr:IRI ;
    rr:class wb:Pokemon
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "name.english" ;
      rr:language "en"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "name.japanese" ;
      rr:language "ja"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "name.chinese" ;
      rr:language "zh"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "name.french" ;
      rr:language "fr"
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:PokedexNumber ;
    rr:objectMap [
      rml:reference "id" ;
      rr:datatype xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:HasSpecies ;
    rr:objectMap [
      rr:template "urn:wikibase:item:Species_{species}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:comment ;
    rr:objectMap [
      rml:reference "description" ;
      rr:datatype xsd:string
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:Attack ;
    rr:objectMap [
      rml:reference "base.Attack" ;
      rr:datatype xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:SpecialAttack ;
    rr:objectMap [
      rml:reference "base.Sp. Attack" ;
      rr:datatype
      xsd:integer
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:Height ;
    rr:objectMap [
      rml:reference "profile.height" ;
      rr:datatype xsd:string
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:Gender ;
    rr:objectMap [
      rml:reference "profile.gender" ;
      rr:datatype xsd:string
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:Sprite ;
    rr:objectMap [
      rml:reference "image.sprite" ;
      rr:datatype xsd:anyURI
    ]
  ] .

<#SpeciesMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:source "data/input/json_pokemon/pokedex_small.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:item:Species_{species}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
      rr:constant wb:Species
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "species"
    ]
  ] .

<#PokemonAbilityLinkMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        json_extract_string(ability_entry, '$[0]') AS ability_name
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:item:Pokemon_{id}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:HasAbility ;
    rr:objectMap [
      rr:template "urn:wikibase:statement:Pokemon_{id}_Ability_{ability_name}" ;
      rr:termType rr:IRI
    ]
  ] .

<#AbilityMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        json_extract_string(ability_entry, '$[0]') AS ability_name
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:item:Ability_{ability_name}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
      rr:constant wb:Ability
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      rml:reference "ability_name"
    ]
  ] .

<#PokemonAbilityStatementMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        json_extract_string(ability_entry, '$[0]') AS ability_name,
        json_extract_string(ability_entry, '$[1]') AS ability_flag
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:statement:Pokemon_{id}_Ability_{ability_name}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
      rr:constant wikibase:Statement
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wikibase:rank ;
    rr:objectMap [
      rr:constant wikibase:PreferredRank
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbt:HasAbility ;
    rr:objectMap [
      rr:template "urn:wikibase:item:Ability_{ability_name}" ;
      rr:termType rr:IRI
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbq:IsHiddenAbility ;
    rr:objectMap [
      rml:reference "ability_flag" ;
      rr:datatype xsd:boolean
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate prov:wasDerivedFrom ;
    rr:objectMap [
      rr:template "urn:wikibase:reference-node:Pokemon_{id}_Ability_{ability_name}_ref" ;
      rr:termType rr:IRI
    ]
  ] .

<#PokemonAbilityReferenceMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        json_extract_string(ability_entry, '$[0]') AS ability_name
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """
  ] ;

  rr:subjectMap [
    rr:template "urn:wikibase:reference-node:Pokemon_{id}_Ability_{ability_name}_ref" ;
    rr:termType rr:IRI
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
      rr:constant wikibase:Reference
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate wbref:StatedIn ;
    rr:objectMap [
      rr:constant "Pokedex" ;
      rr:datatype xsd:string
    ]
  ] .
