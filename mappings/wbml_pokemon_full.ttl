      wbml:nodeTemplate "Type_{target_type}" ;
      wbml:classMap wbml:TypeClass
    ]
  ] .

<#TypeNoEffectMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        english,
        unnest(no_effect) AS target_type
      FROM read_json('data/input/json_pokemon/types.json')
      WHERE no_effect IS NOT NULL
    """
  ] ;

  wbml:subjectMap [
    wbml:nodeTemplate "Type_{english}" ;
    wbml:classMap wbml:TypeClass
  ] ;

  wbml:predicateObjectMap [
    wbml:predicate wbml:NoEffectAgainst ;
    wbml:objectMap [
      wbml:nodeTemplate "Type_{target_type}" ;
      wbml:classMap wbml:TypeClass
    ]
  ] .

#################################################################
# ITEMS
#################################################################

<#ItemMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        type,
        description,
        CASE
          WHEN typeof(name) = 'JSON' THEN json_extract_string(name, '$.english')
          ELSE CAST(name AS VARCHAR)
        END AS name_en,
        CASE
          WHEN typeof(name) = 'JSON' THEN json_extract_string(name, '$.japanese')
          ELSE NULL
        END AS name_ja,
        CASE
          WHEN typeof(name) = 'JSON' THEN json_extract_string(name, '$.chinese')
          ELSE NULL
        END AS name_zh
      FROM read_json('data/input/json_pokemon/items_small.json')
    """
  ] ;

  wbml:subjectMap [
    wbml:nodeTemplate "Item_{id}" ;
    wbml:classMap wbml:ItemClass
  ] ;

  wbml:predicateObjectMap [
    wbml:predicate rdfs:label ;
    wbml:objectMap [ wbml:reference "name_en" ; wbml:language "en" ]
  ] ;

  wbml:predicateObjectMap [
    wbml:predicate rdfs:label ;
    wbml:objectMap [ wbml:reference "name_ja" ; wbml:language "ja" ]
  ] ;

  wbml:predicateObjectMap [
    wbml:predicate rdfs:label ;
    wbml:objectMap [ wbml:reference "name_zh" ; wbml:language "zh" ]
  ] ;

  wbml:predicateObjectMap [
    wbml:predicate rdfs:comment ;
    wbml:objectMap [ wbml:reference "description" ; wbml:language "en" ]
  ] ;

  wbml:predicateObjectMap [
    wbml:predicate wbml:ItemNumber ;
    wbml:objectMap [ wbml:reference "id" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:predicateObjectMap [
    wbml:predicate wbml:HasItemCategory ;
    wbml:objectMap [
        wbml:parentTriplesMap <#ItemCategoryMapping> ;
        wbml:joinCondition [
        wbml:child "type" ;
        wbml:parent "type"
        ]
    ]
    ] .

<#ItemCategoryMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT DISTINCT type
      FROM read_json('data/input/json_pokemon/items_small.json')
      WHERE type IS NOT NULL
    """
  ] ;

  wbml:subjectMap [
    wbml:nodeTemplate "ItemCategory_{type}" ;
    wbml:classMap wbml:ItemCategoryClass
  ] ;

  wbml:predicateObjectMap [
    wbml:predicate rdfs:label ;
    wbml:objectMap [ wbml:reference "type" ; wbml:language "en" ]
  ] .
