@prefix ns1: <http://www.w3.org/ns/r2rml#> .
@prefix ns2: <http://semweb.mmlab.be/ns/rml#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/wbml#AbilityClass> a rdfs:Class ;
    rdfs:label "Ability"@en,
        "Capacité"@fr ;
    rdfs:comment "A special power or skill that a Pokémon can have."@en ;
    skos:altLabel "Pokemon Ability"@en .

<https://example.org/wbml#PokemonClass> a rdfs:Class ;
    rdfs:label "Pokemon"@en,
        "Pokémon"@fr ;
    rdfs:comment "A fictional creature from the Pokémon franchise."@en .

<https://example.org/wbml#SpeciesClass> a rdfs:Class ;
    rdfs:label "Species"@en,
        "Espèce"@fr ;
    rdfs:comment "The species or classification of a Pokémon."@en ;
    skos:altLabel "Pokemon Species"@en .

<file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokedex.ttl#AbilityMapping> a ns1:TriplesMap ;
    ns2:logicalSource [ ns2:query """
      SELECT
        json_extract_string(ability_entry, '$[0]') AS ability_name
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """ ] ;
    ns1:predicateObjectMap <file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokedex.ttl#AbilityMapping/pom/label/n3823cbcf4ca349ca96e86f541d9f26dbb52> ;
    ns1:subjectMap <file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokedex.ttl#AbilityMapping/subjectMap> .

