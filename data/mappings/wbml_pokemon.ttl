#################################################################
# ITEMS
#################################################################

<#ItemMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        type,
        description,
        name.english AS name_en,
        name.japanese AS name_ja,
        name.chinese AS name_zh
      FROM read_json('data/input/json_pokemon/items_small.json')
    """
  ] ;

  wbml:entityMap [
    wbml:nodeTemplate "Item_{id}" ;
    wbml:class wbml:ItemClass
  ] ;

  wbml:label [
    wbml:valueMap [ wbml:reference "name_en" ; wbml:language "en" ]
  ] ;

  wbml:label [
    wbml:valueMap [ wbml:reference "name_ja" ; wbml:language "ja" ]
  ] ;

  wbml:label [
    wbml:valueMap [ wbml:reference "name_zh" ; wbml:language "zh" ]
  ] ;

  wbml:description [
    wbml:valueMap [ wbml:reference "description" ; wbml:language "en" ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:ItemNumber ;
    wbml:valueMap [ wbml:reference "id" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:HasItemCategory ;
    wbml:valueMap [
        wbml:parentTriplesMap <#ItemCategoryMapping> ;
        wbml:joinCondition [
        wbml:child "type" ;
        wbml:parent "type"
        ]
    ]
    ] .

<#ItemCategoryMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT DISTINCT type
      FROM read_json('data/input/json_pokemon/items_small.json')
      WHERE type IS NOT NULL
    """
  ] ;

  wbml:entityMap [
    wbml:nodeTemplate "ItemCategory_{type}" ;
    wbml:class [
      a wbml:Class ;
      wbml:nodeTemplate "ItemCategory" ;
      wbml:entityLabel "Item Category"@en ;
      wbml:entityLabel "Catégorie d'objet"@fr ;
      wbml:entityDescription "A category or classification for items in the Pokémon games."@en ;
      wbml:entityAlias "Pokemon Item Category"@en
    ]
  ] ;

  wbml:label [
    wbml:valueMap [ wbml:reference "type" ; wbml:language "en" ]
  ] .
