@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@prefix wbml: <https://example.org/wbml#> .

# Class definitions
wbml:AbilityClass a wbml:Class ;
  wbml:entityLabel "Ability"@en ;
  wbml:entityLabel "Capacité"@fr ;
  wbml:entityDescription "A special power or skill that a Pokémon can have."@en ;
  wbml:entityAlias "Pokemon Ability"@en .

wbml:SpeciesClass a wbml:Class ;
  wbml:entityLabel "Species"@en ;
  wbml:entityLabel "Espèce"@fr ;
  wbml:entityDescription "The species or classification of a Pokémon."@en ;
  wbml:entityAlias "Pokemon Species"@en .

wbml:TypeClass a wbml:Class ;
  wbml:entityLabel "Type"@en ;
  wbml:entityLabel "Type"@fr ;
  wbml:entityDescription "The elemental type of a Pokémon or move."@en .

wbml:EggGroupClass a wbml:Class ;
  wbml:entityLabel "Egg Group"@en ;
  wbml:entityLabel "Groupe d'œuf"@fr ;
  wbml:entityDescription "The egg group classification for Pokémon breeding."@en .

wbml:MoveClass a wbml:Class ;
  wbml:entityLabel "Move"@en ;
  wbml:entityLabel "Attaque"@fr ;
  wbml:entityDescription "A move or ability that a Pokémon can learn."@en .

wbml:ItemClass a wbml:Class ;
  wbml:entityLabel "Item"@en ;
  wbml:entityLabel "Objet"@fr ;
  wbml:entityDescription "An item that can be used in the Pokémon games."@en .

# Predicate definitions
wbml:HasSpecies a wbml:Property ;
    wbml:entityLabel "has species"@en ;
    wbml:entityDescription "Indicates the species of the Pokémon."@en ;
    wbml:propertyType wbml:item .

wbml:IsHiddenAbility a wbml:Property ;
    wbml:entityLabel "is hidden ability"@en ;
    wbml:propertyType wbml:string ;
    wbml:entityAlias "Is Hidden Ability"@en .

wbml:PokedexNumber a  wbml:Property ;
    wbml:entityLabel "Pokédex number"@en ;
    wbml:propertyType wbml:quantity .

wbml:Attack a wbml:Property ;
    wbml:entityLabel "Attack"@en ;
    wbml:propertyType wbml:quantity .

wbml:SpecialAttack a wbml:Property ;
    wbml:entityLabel "Special Attack"@en ;
    wbml:propertyType wbml:quantity .

wbml:Gender a wbml:Property ;
    wbml:entityLabel "Gender"@en ;
    wbml:propertyType wbml:string .

wbml:HasAbility a wbml:Property ;
    wbml:entityLabel "has ability"@en ;
    wbml:propertyType wbml:item .

wbml:StatedIn a wbml:Property ;
    wbml:entityLabel "stated in"@en ;
    wbml:propertyType wbml:string .

wbml:StatedOn a wbml:Property ;
    wbml:entityLabel "stated on"@en ;
    wbml:propertyType wbml:time ;
    wbml:entityAlias "Stated On"@en .

wbml:PokemonHasType a wbml:Property ;
    wbml:entityLabel "has type"@en ;
    wbml:entityAlias "Pokemon Has Type"@en ;
    wbml:propertyType wbml:item .

wbml:HasEggGroup a wbml:Property ;
    wbml:entityLabel "has egg group"@en ;
    wbml:propertyType wbml:item .

wbml:EvolvesFrom a wbml:Property ;
    wbml:entityLabel "evolves from"@en ;
    wbml:propertyType wbml:item .

wbml:EvolvesTo a wbml:Property ;
    wbml:entityLabel "evolves to"@en ;
    wbml:propertyType wbml:item .

wbml:EvolutionCondition a wbml:Property ;
    wbml:entityLabel "evolution condition"@en ;
    wbml:propertyType wbml:string .

wbml:EffectiveAgainst a wbml:Property ;
    wbml:entityLabel "effective against"@en ;
    wbml:propertyType wbml:item .

wbml:IneffectiveAgainst a wbml:Property ;
    wbml:entityLabel "ineffective against"@en ;
    wbml:propertyType wbml:item .

wbml:NoEffectAgainst a wbml:Property ;
    wbml:entityLabel "no effect against"@en ;
    wbml:propertyType wbml:item .

wbml:HasImage a wbml:Property ;
    wbml:entityLabel "has image"@en ;
    wbml:propertyType wbml:url .

wbml:MoveHasType a wbml:Property ;
    wbml:entityLabel "has type"@en ;
    wbml:entityAlias "Move Has Type"@en ;
    wbml:propertyType wbml:item .

wbml:Accuracy a wbml:Property ;
    wbml:entityLabel "Accuracy"@en ;
    wbml:propertyType wbml:quantity .

wbml:Power a wbml:Property ;
    wbml:entityLabel "Power"@en ;
    wbml:propertyType wbml:quantity .

wbml:PP a wbml:Property ;
    wbml:entityLabel "PP"@en ;
    wbml:propertyType wbml:quantity ;
    wbml:entityAlias "Power Points"@en .

wbml:MoveCategory a wbml:Property ;
    wbml:entityLabel "Move Category"@en ;
    wbml:propertyType wbml:string ;
    wbml:entityAlias "Has Category"@en .

wbml:TMNumber a wbml:Property ;
    wbml:entityLabel "TM Number"@en ;
    wbml:propertyType wbml:quantity .

wbml:ImageType a wbml:Property ;
    wbml:entityLabel "Image Type"@en ;
    wbml:propertyType wbml:string ;
    wbml:entityAlias "Has Image Type"@en .

wbml:HP a wbml:Property ;
    wbml:entityLabel "HP"@en ;
    wbml:propertyType wbml:quantity ;
    wbml:entityAlias "Hit Points"@en .

wbml:Defense a wbml:Property ;
    wbml:entityLabel "Defense"@en ;
    wbml:propertyType wbml:quantity .

wbml:SpecialDefense a wbml:Property ;
    wbml:entityLabel "Special Defense"@en ;
    wbml:propertyType wbml:quantity ;
    wbml:entityAlias "Sp. Defense"@en .

wbml:Weight a wbml:Property ;
    wbml:entityLabel "Weight"@en ;
    wbml:propertyType wbml:string .

wbml:ItemNumber a wbml:Property ;
    wbml:entityLabel "Item Number"@en ;
    wbml:propertyType wbml:quantity .

wbml:HasItemCategory a wbml:Property ;
    wbml:entityLabel "has item category"@en ;
    wbml:propertyType wbml:item .

#################################################################
# POKEMON
#################################################################

<#PokemonMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:source "data/input/json_pokemon/pokedex_small.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;

  wbml:entityMap [
    wbml:nodeTemplate "Pokemon_{id}" ;
    wbml:classId "Q6999"
  ] ;

  wbml:label [
    wbml:valueMap [ wbml:reference "name.english" ; wbml:language "en" ]
  ] ;

  wbml:label [
    wbml:valueMap [ wbml:reference "name.japanese" ; wbml:language "ja" ]
  ] ;

  wbml:label [
    wbml:valueMap [ wbml:reference "name.chinese" ; wbml:language "zh" ]
  ] ;

  wbml:label [
    wbml:valueMap [ wbml:reference "name.french" ; wbml:language "fr" ]
  ] ;

  wbml:description [
    wbml:valueMap [ wbml:reference "description" ; wbml:language "en" ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:PokedexNumber ;
    wbml:valueMap [ wbml:reference "id" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:HasSpecies ;
    wbml:rank wbml:PreferredRank ;
    wbml:valueMap [
      wbml:nodeTemplate "Species_{species}"
    ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:HP ;
    wbml:valueMap [ wbml:reference "base.HP" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:Attack ;
    wbml:valueMap [ wbml:reference "base.Attack" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:Defense ;
    wbml:valueMap [ wbml:reference "base.Defense" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:SpecialAttack ;
    wbml:valueMap [ wbml:reference "base.Sp. Attack" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:SpecialDefense ;
    wbml:valueMap [ wbml:reference "base.Sp. Defense" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap [
      a wbml:Property ;
      wbml:nodeTemplate "Speed" ;
      wbml:entityLabel "Speed"@en ;
      wbml:propertyType wbml:quantity ;
      wbml:entityAlias "Base Speed"@en
    ] ;
    wbml:valueMap [ wbml:reference "base.Speed" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:statementMap [
    wbml:propertyId "P56" ;
    wbml:valueMap [ wbml:reference "profile.height" ; wbml:datatype xsd:string ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:Weight ;
    wbml:valueMap [ wbml:reference "profile.weight" ; wbml:datatype xsd:string ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:Gender ;
    wbml:valueMap [ wbml:reference "profile.gender" ; wbml:datatype xsd:string ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:HasImage ;
    wbml:valueMap [ wbml:reference "image.sprite" ; wbml:datatype xsd:anyURI ] ;
    wbml:qualifierMap [
      wbml:propertyMap wbml:ImageType ;
      wbml:valueMap [ wbml:constant "sprite" ; wbml:datatype xsd:string ]
    ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:HasImage ;
    wbml:valueMap [ wbml:reference "image.thumbnail" ; wbml:datatype xsd:anyURI ] ;
    wbml:qualifierMap [
      wbml:propertyMap wbml:ImageType ;
      wbml:valueMap [ wbml:constant "thumbnail" ; wbml:datatype xsd:string ]
    ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:HasImage ;
    wbml:valueMap [ wbml:reference "image.hires" ; wbml:datatype xsd:anyURI ] ;
    wbml:qualifierMap [
      wbml:propertyMap wbml:ImageType ;
      wbml:valueMap [ wbml:constant "hires" ; wbml:datatype xsd:string ]
    ]
  ] .

<#PokemonTypeMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        unnest(type) AS type_name
      FROM read_json('data/input/json_pokemon/pokedex_small.json')
      WHERE type IS NOT NULL
    """
  ] ;

  wbml:entityMap [
    wbml:nodeTemplate "Pokemon_{id}" ;
    wbml:classId "Q6999"
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:PokemonHasType ;
    wbml:valueMap [
      wbml:nodeTemplate "Type_{type_name}" ;
    ]
  ] .

<#PokemonEggGroupMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        unnest(profile.egg) AS egg_group
      FROM read_json('data/input/json_pokemon/pokedex_small.json')
      WHERE profile.egg IS NOT NULL
    """
  ] ;

  wbml:entityMap [
    wbml:nodeTemplate "Pokemon_{id}" ;
    wbml:classId "Q6999"
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:HasEggGroup ;
    wbml:valueMap [
      wbml:nodeTemplate "EggGroup_{egg_group}"
    ]
  ] .

<#PokemonAbilityStatementMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        json_extract_string(ability_entry, '$[0]') AS ability_name,
        json_extract_string(ability_entry, '$[1]') AS ability_flag
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """
  ] ;

  wbml:entityMap [
    wbml:nodeTemplate "Pokemon_{id}" ;
    wbml:classId "Q6999"
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:HasAbility ;
    wbml:valueMap [
      wbml:nodeTemplate "Ability_{ability_name}"
    ] ;
    wbml:qualifierMap [
      wbml:propertyMap wbml:IsHiddenAbility ;
      wbml:valueMap [
        wbml:reference "ability_flag" ;
        wbml:datatype xsd:boolean
      ]
    ] ;
    wbml:referenceMap [
      wbml:referenceRecord [
        wbml:propertyMap wbml:StatedIn ;
        wbml:valueMap [
          wbml:constant "pokedex.json" ;
          wbml:datatype xsd:string
        ]
      ] ;
      wbml:referenceRecord [
        wbml:propertyMap wbml:StatedOn ;
        wbml:valueMap [
          wbml:constant "2023-01-01" ;
          wbml:datatype xsd:date
        ]
      ]
    ] ;
    wbml:referenceMap [
      wbml:referenceRecord [
        wbml:propertyMap wbml:StatedIn ;
        wbml:valueMap [
          wbml:constant "pokedex.json" ;
          wbml:datatype xsd:string
        ]
      ] ;
      wbml:referenceRecord [
        wbml:propertyMap wbml:StatedOn ;
        wbml:valueMap [
          wbml:constant "2023-01-05" ;
          wbml:datatype xsd:date
        ]
      ]
    ]
  ] .

<#PokemonEvolutionPrevMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        json_extract_string(evolution.prev, '$[0]') AS prev_id,
        json_extract_string(evolution.prev, '$[1]') AS prev_condition
      FROM read_json('data/input/json_pokemon/pokedex_small.json')
      WHERE evolution.prev IS NOT NULL
    """
  ] ;

  wbml:entityMap [
    wbml:nodeTemplate "Pokemon_{id}" ;
    wbml:classId "Q6999"
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:EvolvesFrom ;
    wbml:valueMap [
      wbml:nodeTemplate "Pokemon_{prev_id}"
    ] ;
    wbml:qualifierMap [
      wbml:propertyMap wbml:EvolutionCondition ;
      wbml:valueMap [
        wbml:reference "prev_condition" ;
        wbml:datatype xsd:string
      ]
    ]
  ] .

<#PokemonEvolutionNextMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT
        id,
        json_extract_string(next_entry, '$[0]') AS next_id,
        json_extract_string(next_entry, '$[1]') AS next_condition
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(evolution.next) AS t(next_entry)
      WHERE evolution.next IS NOT NULL
    """
  ] ;

  wbml:entityMap [
    wbml:nodeTemplate "Pokemon_{id}" ;
    wbml:classId "Q6999"
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:EvolvesTo ;
    wbml:valueMap [
      wbml:nodeTemplate "Pokemon_{next_id}"
    ] ;
    wbml:qualifierMap [
      wbml:propertyMap wbml:EvolutionCondition ;
      wbml:valueMap [
        wbml:reference "next_condition" ;
        wbml:datatype xsd:string
      ]
    ]
  ] .

#################################################################
# POKEMON SUPPORT ENTITIES
#################################################################

<#SpeciesMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:source "data/input/json_pokemon/pokedex_small.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;

  wbml:entityMap [
    wbml:nodeTemplate "Species_{species}" ;
    wbml:class wbml:SpeciesClass
  ] ;

  wbml:label [
    wbml:valueMap [
      wbml:reference "species" ;
      wbml:language "en"
    ]
  ] .

<#AbilityMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT DISTINCT
        json_extract_string(ability_entry, '$[0]') AS ability_name
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """
  ] ;

  wbml:entityMap [
    wbml:nodeTemplate "Ability_{ability_name}" ;
    wbml:class wbml:AbilityClass
  ] ;

  wbml:label [
    wbml:valueMap [ wbml:reference "ability_name" ; wbml:language "en" ]
  ] .

<#EggGroupMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:query """
      SELECT DISTINCT
        unnest(profile.egg) AS egg_group
      FROM read_json('data/input/json_pokemon/pokedex_small.json')
      WHERE profile.egg IS NOT NULL
    """
  ] ;

  wbml:entityMap [
    wbml:nodeTemplate "EggGroup_{egg_group}" ;
    wbml:class wbml:EggGroupClass
  ] ;

  wbml:label [
    wbml:valueMap [ wbml:reference "egg_group" ; wbml:language "en" ]
  ] .

#################################################################
# MOVES
#################################################################

<#MoveMapping>
  a rr:TriplesMap ;

  rml:logicalSource [
    rml:source "data/input/json_pokemon/moves_small.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;

  wbml:entityMap [
    wbml:nodeTemplate "Move_{id}" ;
    wbml:class wbml:MoveClass
  ] ;

  wbml:label [
    wbml:valueMap [ wbml:reference "ename" ; wbml:language "en" ]
  ] ;

  wbml:label [
    wbml:valueMap [ wbml:reference "jname" ; wbml:language "ja" ]
  ] ;

  wbml:label [
    wbml:valueMap [ wbml:reference "cname" ; wbml:language "zh" ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:Accuracy ;
    wbml:valueMap [ wbml:reference "accuracy" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:Power ;
    wbml:valueMap [ wbml:reference "power" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:PP ;
    wbml:valueMap [ wbml:reference "pp" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:MoveCategory ;
    wbml:valueMap [ wbml:reference "category" ; wbml:datatype xsd:string ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:TMNumber ;
    wbml:valueMap [ wbml:reference "tm" ; wbml:datatype xsd:integer ]
  ] ;

  wbml:statementMap [
    wbml:propertyMap wbml:MoveHasType ;
    wbml:valueMap [
      wbml:nodeTemplate "Type_{type}"
    ]
  ] .

