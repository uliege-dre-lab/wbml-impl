@prefix ns1: <http://www.w3.org/ns/r2rml#> .
@prefix ns2: <http://semweb.mmlab.be/ns/rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/wbml#AbilityClass> a rdfs:Class ;
    rdfs:label "Ability"@en,
        "Capacité"@fr ;
    rdfs:comment "A special power or skill that a Pokémon can have."@en ;
    skos:altLabel "Pokemon Ability"@en .

<https://example.org/wbml#EggGroupClass> a rdfs:Class ;
    rdfs:label "Egg Group"@en,
        "Groupe d'œuf"@fr ;
    rdfs:comment "The egg group classification for Pokémon breeding."@en .

<https://example.org/wbml#ItemClass> a rdfs:Class ;
    rdfs:label "Item"@en,
        "Objet"@fr ;
    rdfs:comment "An item that can be used in the Pokémon games."@en .

<https://example.org/wbml#MoveClass> a rdfs:Class ;
    rdfs:label "Move"@en,
        "Attaque"@fr ;
    rdfs:comment "A move or ability that a Pokémon can learn."@en .

<https://example.org/wbml#SpeciesClass> a rdfs:Class ;
    rdfs:label "Species"@en,
        "Espèce"@fr ;
    rdfs:comment "The species or classification of a Pokémon."@en ;
    skos:altLabel "Pokemon Species"@en .

<https://example.org/wbml#TypeClass> a rdfs:Class ;
    rdfs:label "Type"@en,
        "Type"@fr ;
    rdfs:comment "The elemental type of a Pokémon or move."@en .

<file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/data/mappings/wbml_pokemon.ttl#AbilityMapping> a ns1:TriplesMap ;
    ns2:logicalSource [ ns2:query """
      SELECT DISTINCT
        json_extract_string(ability_entry, '$[0]') AS ability_name
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """ ] ;
    ns1:predicateObjectMap <file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/data/mappings/wbml_pokemon.ttl#AbilityMapping/pom/label/n82d424b0f6ce4530a2e521b1b35cd745b91> ;
    ns1:subjectMap <file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/data/mappings/wbml_pokemon.ttl#AbilityMapping/subjectMap> .

<file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/data/mappings/wbml_pokemon.ttl#EggGroupMapping> a ns1:TriplesMap ;
    ns2:logicalSource [ ns2:query """
      SELECT DISTINCT
        unnest(profile.egg) AS egg_group
      FROM read_json('data/input/json_pokemon/pokedex_small.json')
      WHERE profile.egg IS NOT NULL
    """ ] ;
    ns1:predicateObjectMap <file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/data/mappings/wbml_pokemon.ttl#EggGroupMapping/pom/label/n82d424b0f6ce4530a2e521b1b35cd745b95> ;
