_:nc6939666812341b5919f285b43a3e7a3b124 ns2:query """
      SELECT
        english,
        unnest(effective) AS target_type
      FROM read_json('data/input/json_pokemon/types.json')
      WHERE effective IS NOT NULL
    """ .

_:nc6939666812341b5919f285b43a3e7a3b128 ns2:query """
      SELECT
        english,
        unnest(ineffective) AS target_type
      FROM read_json('data/input/json_pokemon/types.json')
      WHERE ineffective IS NOT NULL
    """ .

_:nc6939666812341b5919f285b43a3e7a3b132 ns2:query """
      SELECT
        english,
        unnest(no_effect) AS target_type
      FROM read_json('data/input/json_pokemon/types.json')
      WHERE no_effect IS NOT NULL
    """ .

_:nc6939666812341b5919f285b43a3e7a3b48 ns2:query """
      SELECT
        id,
        unnest(type) AS type_name
      FROM read_json('data/input/json_pokemon/pokedex_small.json')
      WHERE type IS NOT NULL
    """ .

_:nc6939666812341b5919f285b43a3e7a3b52 ns2:query """
      SELECT
        id,
        unnest(profile.egg) AS egg_group
      FROM read_json('data/input/json_pokemon/pokedex_small.json')
      WHERE profile.egg IS NOT NULL
    """ .

_:nc6939666812341b5919f285b43a3e7a3b72 ns2:query """
      SELECT
        id,
        json_extract_string(evolution.prev, '$[0]') AS prev_id,
        json_extract_string(evolution.prev, '$[1]') AS prev_condition
      FROM read_json('data/input/json_pokemon/pokedex_small.json')
      WHERE evolution.prev IS NOT NULL
    """ .

_:nc6939666812341b5919f285b43a3e7a3b78 ns2:query """
      SELECT
        id,
        json_extract_string(next_entry, '$[0]') AS next_id,
        json_extract_string(next_entry, '$[1]') AS next_condition
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(evolution.next) AS t(next_entry)
      WHERE evolution.next IS NOT NULL
    """ .

_:nc6939666812341b5919f285b43a3e7a3b136 ns2:query """
      SELECT
        id,
        type,
        description,
        name.english AS name_en,
        name.japanese AS name_ja,
        name.chinese AS name_zh
      FROM read_json('data/input/json_pokemon/items_small.json')
    """ .

_:nc6939666812341b5919f285b43a3e7a3b56 ns2:query """
      SELECT
        id,
        json_extract_string(ability_entry, '$[0]') AS ability_name,
        json_extract_string(ability_entry, '$[1]') AS ability_flag
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """ .

