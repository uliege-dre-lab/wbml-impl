_:n590fad2976ab4faab84238072f333a1fb119 ns1:query """\r
      SELECT\r
        english,\r
        unnest(effective) AS target_type\r
      FROM read_json('data/input/json_pokemon/types.json')\r
      WHERE effective IS NOT NULL\r
    """ .

_:n590fad2976ab4faab84238072f333a1fb123 ns1:query """\r
      SELECT\r
        english,\r
        unnest(ineffective) AS target_type\r
      FROM read_json('data/input/json_pokemon/types.json')\r
      WHERE ineffective IS NOT NULL\r
    """ .

_:n590fad2976ab4faab84238072f333a1fb127 ns1:query """\r
      SELECT\r
        english,\r
        unnest(no_effect) AS target_type\r
      FROM read_json('data/input/json_pokemon/types.json')\r
      WHERE no_effect IS NOT NULL\r
    """ .

_:n590fad2976ab4faab84238072f333a1fb41 ns1:query """\r
      SELECT\r
        id,\r
        unnest(type) AS type_name\r
      FROM read_json('data/input/json_pokemon/pokedex_small.json')\r
      WHERE type IS NOT NULL\r
    """ .

_:n590fad2976ab4faab84238072f333a1fb45 ns1:query """\r
      SELECT\r
        id,\r
        unnest(profile.egg) AS egg_group\r
      FROM read_json('data/input/json_pokemon/pokedex_small.json')\r
      WHERE profile.egg IS NOT NULL\r
    """ .

_:n590fad2976ab4faab84238072f333a1fb65 ns1:query """\r
      SELECT\r
        id,\r
        json_extract_string(evolution.prev, '$[0]') AS prev_id,\r
        json_extract_string(evolution.prev, '$[1]') AS prev_condition\r
      FROM read_json('data/input/json_pokemon/pokedex_small.json')\r
      WHERE evolution.prev IS NOT NULL\r
    """ .

_:n590fad2976ab4faab84238072f333a1fb71 ns1:query """\r
      SELECT\r
        id,\r
        json_extract_string(next_entry, '$[0]') AS next_id,\r
        json_extract_string(next_entry, '$[1]') AS next_condition\r
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),\r
           unnest(evolution.next) AS t(next_entry)\r
      WHERE evolution.next IS NOT NULL\r
    """ .

_:n590fad2976ab4faab84238072f333a1fb131 ns1:query """\r
      SELECT\r
        id,\r
        type,\r
        description,\r
        CASE\r
          WHEN typeof(name) = 'JSON' THEN json_extract_string(name, '$.english')\r
          ELSE CAST(name AS VARCHAR)\r
        END AS name_en,\r
        CASE\r
          WHEN typeof(name) = 'JSON' THEN json_extract_string(name, '$.japanese')\r
          ELSE NULL\r
        END AS name_ja,\r
        CASE\r
          WHEN typeof(name) = 'JSON' THEN json_extract_string(name, '$.chinese')\r
          ELSE NULL\r
        END AS name_zh\r
      FROM read_json('data/input/json_pokemon/items_small.json')\r
    """ .

_:n590fad2976ab4faab84238072f333a1fb49 ns1:query """\r
      SELECT\r
        id,\r
        json_extract_string(ability_entry, '$[0]') AS ability_name,\r
        json_extract_string(ability_entry, '$[1]') AS ability_flag\r
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),\r
           unnest(profile.ability) AS t(ability_entry)\r
      WHERE profile.ability IS NOT NULL\r
    """ .

_:n590fad2976ab4faab84238072f333a1fb89 ns1:iterator "$[*]" ;
    ns1:referenceFormulation <http://semweb.mmlab.be/ns/ql#JSONPath> ;
    ns1:source "data/input/json_pokemon/moves_small.json" .

_:n590fad2976ab4faab84238072f333a1fb1 ns1:iterator "$[*]" ;
    ns1:referenceFormulation <http://semweb.mmlab.be/ns/ql#JSONPath> ;
    ns1:source "data/input/json_pokemon/pokedex_small.json" .
