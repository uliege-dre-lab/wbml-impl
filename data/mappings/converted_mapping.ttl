<https://example.org/wbml#AbilityClass> a rdfs:Class ;
    rdfs:label "Ability"@en,
        "Capacité"@fr ;
    rdfs:comment "A special power or skill that a Pokémon can have."@en ;
    skos:altLabel "Pokemon Ability"@en .

<https://example.org/wbml#SpeciesClass> a rdfs:Class ;
    rdfs:label "Species"@en,
        "Espèce"@fr ;
    rdfs:comment "The species or classification of a Pokémon."@en ;
    skos:altLabel "Pokemon Species"@en .

<file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokedex.ttl#AbilityMapping> a ns2:TriplesMap ;
    ns1:logicalSource [ ns1:query """
      SELECT
        json_extract_string(ability_entry, '$[0]') AS ability_name
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """ ] ;
    ns2:predicateObjectMap <file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokedex.ttl#AbilityMapping/pom/label/ndaaa55bbdde14b82a25f9fedc158ae1cb58> ;
    ns2:subjectMap <file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokedex.ttl#AbilityMapping/subjectMap> .

