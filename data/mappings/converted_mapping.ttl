_:ndaaa55bbdde14b82a25f9fedc158ae1cb46 ns1:iterator "$[*]" ;
    ns1:referenceFormulation <http://semweb.mmlab.be/ns/ql#JSONPath> ;
    ns1:source "data/input/json_pokemon/pokedex_small.json" .

_:ndaaa55bbdde14b82a25f9fedc158ae1cb29 ns1:query """
      SELECT
        id,
        json_extract_string(ability_entry, '$[0]') AS ability_name,
        json_extract_string(ability_entry, '$[1]') AS ability_flag
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """ .

_:ndaaa55bbdde14b82a25f9fedc158ae1cb1 ns1:iterator "$[*]" ;
    ns1:referenceFormulation <http://semweb.mmlab.be/ns/ql#JSONPath> ;
    ns1:source "data/input/json_pokemon/pokedex_small.json" .
