<file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokemon_full.ttl#AbilityMapping> a ns2:TriplesMap ;
    ns1:logicalSource [ ns1:query """
      SELECT DISTINCT
        json_extract_string(ability_entry, '$[0]') AS ability_name
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),
           unnest(profile.ability) AS t(ability_entry)
      WHERE profile.ability IS NOT NULL
    """ ] ;
    ns2:predicateObjectMap <file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokemon_full.ttl#AbilityMapping/pom/label/n4a991515259f4543a7efe086191090a5b84> ;
    ns2:subjectMap <file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokemon_full.ttl#AbilityMapping/subjectMap> .

<file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokemon_full.ttl#EggGroupMapping> a ns2:TriplesMap ;
    ns1:logicalSource [ ns1:query """
      SELECT DISTINCT
        unnest(profile.egg) AS egg_group
      FROM read_json('data/input/json_pokemon/pokedex_small.json')
      WHERE profile.egg IS NOT NULL
    """ ] ;
    ns2:predicateObjectMap <file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokemon_full.ttl#EggGroupMapping/pom/label/n4a991515259f4543a7efe086191090a5b88> ;
