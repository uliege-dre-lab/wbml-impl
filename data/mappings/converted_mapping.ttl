<file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokemon_full.ttl#AbilityMapping> a ns1:TriplesMap ;
    ns2:logicalSource [ ns2:query """\r
      SELECT DISTINCT\r
        json_extract_string(ability_entry, '$[0]') AS ability_name\r
      FROM read_json('data/input/json_pokemon/pokedex_small.json'),\r
           unnest(profile.ability) AS t(ability_entry)\r
      WHERE profile.ability IS NOT NULL\r
    """ ] ;
    ns1:predicateObjectMap <file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokemon_full.ttl#AbilityMapping/pom/label/n825dddd305b3433689d7b40242ad09efb77> ;
    ns1:subjectMap <file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokemon_full.ttl#AbilityMapping/subjectMap> .

<file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokemon_full.ttl#EggGroupMapping> a ns1:TriplesMap ;
    ns2:logicalSource [ ns2:query """\r
      SELECT DISTINCT\r
        unnest(profile.egg) AS egg_group\r
      FROM read_json('data/input/json_pokemon/pokedex_small.json')\r
      WHERE profile.egg IS NOT NULL\r
    """ ] ;
    ns1:predicateObjectMap <file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/mappings/wbml_pokemon_full.ttl#EggGroupMapping/pom/label/n825dddd305b3433689d7b40242ad09efb81> ;
