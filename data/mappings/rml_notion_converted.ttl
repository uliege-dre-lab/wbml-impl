_:n750cf2f9ddbe4088aa4455a1fd7adf3fb15 ns2:query """
      SELECT
        "Nom de la classe" AS name,
        "Hiérarchie (classe parent)" AS parent_class
      FROM read_csv(
        'data/input/csv_notion/classes_with_english_translations.csv',
        header = true
      )
      WHERE "Nom de la classe" IS NOT NULL
        AND trim("Nom de la classe") != ''
        AND "Hiérarchie (classe parent)" IS NOT NULL
        AND trim("Hiérarchie (classe parent)") != ''
    """ .

_:n750cf2f9ddbe4088aa4455a1fd7adf3fb19 ns2:query """
      SELECT
        "Nom" AS name,
        "Description" AS description,
        "Domaine" AS domain,
        "English name" AS name_en,
        "Description (EN)" AS description_en,
        "Cardinalité" AS cardinality,
        "Bonnes pratiques" AS good_practices
      FROM read_csv(
        'data/input/csv_notion/data_properties_with_english_translations.csv',
        header = true
      )
      WHERE "Nom" IS NOT NULL
        AND trim("Nom") != ''
        AND (
          "Portée" IS NULL
          OR "Portée" NOT IN ('URL', 'URI', 'DateTime')
        )
    """ .

_:n750cf2f9ddbe4088aa4455a1fd7adf3fb55 ns2:query """
      SELECT
        "Nom" AS name,
        "Description" AS description,
        "Domaine" AS domain,
        "English name" AS name_en,
        "Description (EN)" AS description_en,
        "Cardinalité" AS cardinality,
        "Bonnes pratiques" AS good_practices,
        "Inverse" AS inverse,
        regexp_replace("Portée", ' \\(.*\\)$', '') AS range_class
      FROM read_csv(
        'data/input/csv_notion/object_properties_with_english_translations.csv',
        header = true
      )
      WHERE "Nom" IS NOT NULL
        AND trim("Nom") != ''
    """ .
