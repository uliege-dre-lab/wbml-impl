<file:///C:/Users/liu00/Documents/Universit%C3%A9/Master2/TFE/ATFE9009-wikibase-rdf-pipeline/data/mappings/wbml_notion.ttl#ObjectPropertyMapping> a ns1:TriplesMap ;
    ns2:logicalSource [ ns2:query """
      SELECT
        "Nom" AS name,
        "Description" AS description,
        "Domaine" AS domain,
        "English name" AS name_en,
        "Description (EN)" AS description_en,
        "Cardinalité" AS cardinality,
        "Bonnes pratiques" AS good_practices,
        "Inverse" AS inverse,
        regexp_replace("Portée", ' \\(.*\\)$', '') AS range_class
      FROM read_csv(
        'data/input/csv_notion/object_properties_with_english_translations.csv',
        header = true
      )
      WHERE "Nom" IS NOT NULL
        AND trim("Nom") != ''
    """ ] ;
